# Quadlet unit for the long-lived curl client on npm-network.
#
# Every host-side check that reads a service by name goes through net_curl
# (scripts/lib.sh), because the app images vary and several carry no curl. It
# execs into this container rather than running a throwaway `podman run` per
# probe: exec output goes to the caller, not the journal, so a probe adds no
# log line at all and creates no veth pair or cgroup scope per sweep
# (docs/units.md, "The host-side probes").
#
# A second container (netcheck-host) runs the same image on the host network:
# podman refuses host + bridge on one container, and nginx-proxy-manager binds
# 127.0.0.1 where only a host-netns client can reach it. Both are sleepers --
# the image has no entrypoint, so Exec= is the whole command.
[Unit]
Description=netcheck (long-lived curl client on npm-network)
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=netcheck
# Built by install.sh from netcheck/Containerfile (Renovate ignores
# localhost/*). deploy.sh calls refresh_image_unit so a rebuilt image reaches
# this already-running container: `systemctl start` is a no-op on an active
# unit.
Image=localhost/netcheck:local
Network=npm-network.network
Exec=sleep infinity

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
