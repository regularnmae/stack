# Quadlet unit for the BoltMesh SPA. deploy.sh builds this image with
# `--target prod` and the three VITE_* build args, so the bundle is static and
# the VITE_API_URL is baked in at build time -- changing the API hostname means
# re-running deploy.sh, not editing a unit. deploy/install.sh renders this into
# ~/.config/containers/systemd/, where quadlet turns it into
# boltmesh-frontend.service.
[Unit]
Description=BoltMesh frontend (static SPA served by nginx)
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=boltmesh-frontend
Image=localhost/boltmesh-frontend:latest
Network=npm-network.network
# Pin the IP: tor's onion target is this address, and tor validates a
# HiddenServicePort target when it starts -- before this container may exist on
# a fresh host. Keep it unique (tor itself is .240).
IP=10.89.0.241

# No env files: the app reads no runtime config, the VITE_* values are inlined
# into the bundle at build time. The image runs nginx on :80 with the SPA
# fallback from frontend/deploy/nginx.conf.

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# SPA on host 8106 (NPM_HOSTS in stack.conf) -- it can no longer resolve the
# container name. Bind 127.0.0.1: the firewall opens nothing for it, so NPM
# (which terminates TLS) stays the only way in for a client.
PublishPort=127.0.0.1:8106:80

# nginx:alpine has no curl but does have busybox wget.
HealthCmd=wget -q -T 4 -t 1 -O /dev/null http://127.0.0.1/
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
