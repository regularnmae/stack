# Quadlet unit for the VictoriaMetrics MCP server.
#
# The authenticated front door to the metrics store: `victoriametrics` has no
# authentication of its own and is loopback-only on purpose, because its labels
# name every service, scrape address, filesystem and device in the stack. A
# client reaches the history through this server and its bearer token, not
# through the store's HTTP API.
[Unit]
Description=VictoriaMetrics MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service victoriametrics.service
Requires=npm-network-network.service victoriametrics.service

[Container]
ContainerName=victoriametrics-mcp
Image=localhost/victoriametrics-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the store this server reads. Both
# live OUTSIDE this repo in $DATA_DIR/config/victoriametrics-mcp/ (mode 600),
# written by install.sh; only the *.example files under deploy/ are committed.
EnvironmentFile=@CONFIG_DIR@/victoriametrics-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/victoriametrics-mcp/upstream.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8112 -- it cannot resolve the container name -- while the app still
# listens on 8000 in its own namespace. The firewall opens nothing for it.
PublishPort=127.0.0.1:8112:8000

# An authenticated MCP initialize probe, so a wedged server is visible and
# restartable. /health is the liveness path; /ready probes the store and must
# never gate podman, or a store restart would restart-loop this container.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
