# Quadlet unit for VictoriaLogs, the stack's log store: the searchable history
# behind `scripts/logs.sh` and the LogsQL UI, fed by `vector` straight from
# journald. Alerting never depends on it.
#
# Single node, one process: it stores one directory per day and deletes whole
# partitions, so retention is a flag, not a compaction job (LOGS_RETENTION and
# LOGS_MAX_BYTES in stack.conf). The store is regenerable, so it is outside the
# backup set.
[Unit]
Description=VictoriaLogs (log store for the stack)
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=victoria-logs
Image=docker.io/victoriametrics/victoria-logs:v1.53.0
Network=npm-network.network

# Loopback only, like the metrics store and for the same reason: it has no
# authentication of its own. Nothing is opened in the firewall and there is no
# NPM host, so read it over an SSH tunnel:   ssh -L 9428:127.0.0.1:9428
# thishost   then http://127.0.0.1:9428/select/vmui The log *content* is why it
# stays that closed: every container's stdout is in here, and a token echoed
# into a log line is one more copy of it.
PublishPort=127.0.0.1:9428:9428

# The store itself. Regenerable: losing it costs the history, nothing else. The
# image runs as container root == the login user under rootless podman, so
# install.sh only creates the directory.
Volume=@DATA_DIR@/logs/vl:/victoria-logs-data:z

# One Exec= line (a Quadlet Exec= is a single command).
# -retention.maxDiskSpaceUsageBytes drops the oldest whole partitions once the
# store exceeds the cap: a second, independent bound on top of the time-based
# one, because a crash-looping service can write far more than a healthy day's
# worth. VictoriaLogs always keeps at least the two most recent days.
Exec=-storageDataPath=/victoria-logs-data -retentionPeriod=@LOGS_RETENTION@ -retention.maxDiskSpaceUsageBytes=@LOGS_MAX_BYTES@ -httpListenAddr=:9428

# No HealthCmd on purpose: the image is distroless (no shell, no wget) and
# podman runs a string health command through the container's /bin/sh. The
# functional check is outside the unit -- verify.sh and the monitor ask the
# HTTP API a real LogsQL question -- and wait_healthy treats a unit with no
# healthcheck as "up".

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
