# Quadlet unit for the Monero wallet MCP server.
[Unit]
Description=Monero Wallet MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service monero-wallet-btcpay.service
Requires=npm-network-network.service

[Container]
ContainerName=monero-wallet-mcp
Image=localhost/monero-wallet-mcp:latest
Network=npm-network.network

# Three env files, all OUTSIDE this repo under
# $DATA_DIR/config/monero-wallet-mcp/ (mode 600), so no secret is committed:
# token.env    -- MONERO_MCP_TOKEN (read) and MONERO_MCP_SPEND_TOKEN
# upstream.env -- the BTCPay view-only wallet's URL (no login)   spend.env
# -- ENABLE_SPENDING and the caps (operator-editable)
EnvironmentFile=@CONFIG_DIR@/monero-wallet-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/monero-wallet-mcp/upstream.env
EnvironmentFile=@CONFIG_DIR@/monero-wallet-mcp/spend.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8103 -- it cannot resolve the container name. The wallet behind it is
# BTCPay's view-only plugin wallet, so even the spend-token tools cannot move
# funds.
PublishPort=127.0.0.1:8103:8000

HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
