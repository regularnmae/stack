# Quadlet unit for the MCP server itself. deploy/install.sh renders this
# into ~/.config/containers/systemd/, where quadlet turns it into
# bitcoin-node-mcp.service.
[Unit]
Description=Bitcoin Node MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service bitcoind.service
Requires=npm-network-network.service

[Container]
ContainerName=bitcoin-node-mcp
Image=localhost/bitcoin-node-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the node's RPC credentials.
# Both live OUTSIDE this repo in $DATA_DIR/config/bitcoin-node-mcp/ (mode 600),
# written by deploy/install.sh, so no secret is ever committed -- only the
# *.example files under deploy/ are.
EnvironmentFile=@CONFIG_DIR@/bitcoin-node-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/bitcoin-node-mcp/upstream.env

# No PublishPort: nothing is exposed to the host (the app listens on 8000 inside
# its own namespace). NPM is the sole path in for a client, reaching the
# container as bitcoin-node-mcp:8000 on npm-network; the host-side checks read it
# the same way, through scripts/lib.sh's net_curl.

# Healthcheck: MCP initialize probe (authenticated). Makes a wedged
# server visible/restartable instead of silently erroring.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=restart

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
