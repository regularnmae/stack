# Quadlet unit for the Bitcoin node MCP server.
[Unit]
Description=Bitcoin Node MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service bitcoind.service
Requires=npm-network-network.service

[Container]
ContainerName=bitcoin-node-mcp
Image=localhost/bitcoin-node-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the node's RPC credentials. Both
# live OUTSIDE this repo in $DATA_DIR/config/bitcoin-node-mcp/ (mode 600),
# written by install.sh; only the *.example files under deploy/ are committed.
EnvironmentFile=@CONFIG_DIR@/bitcoin-node-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/bitcoin-node-mcp/upstream.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8101 -- it cannot resolve the container name -- while the app still
# listens on 8000 in its own namespace. The firewall opens nothing for it, and
# host-side checks read the container by name on npm-network through net_curl.
PublishPort=127.0.0.1:8101:8000

# An authenticated MCP initialize probe, which makes a wedged server visible
# and restartable instead of silently erroring.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
