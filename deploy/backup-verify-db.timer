# The schedule for the database drill in backup-verify-db.service.
#
# Quadlet has no .timer type, so this is a plain systemd USER unit (like
# backup.timer); install.sh installs it and enables it --user.
[Unit]
Description=Monthly database restore drill for the stack's restic backup

[Timer]
# First Wednesday at 06:30. `Wed *-*-01..07` is systemd's "first Wednesday",
# and the choice avoids two collisions: a monthly-on-the-1st expression can
# land on a Sunday, and the weekly drill starts at 05:30 with up to 30 min of
# jitter and up to two hours of runtime, so the two would fight over the
# repository lock. This is 24h+ clear of it, and of the nightly backup at
# 03:30.
OnCalendar=Wed *-*-01..07 06:30:00
RandomizedDelaySec=30m
# Persistent=true catches up a run missed while the host was off, which means a
# host deployed after the first Wednesday runs one immediately -- harmless,
# since the live data dirs are never mounted, and it proves the replay path on
# the new host.
Persistent=true
Unit=backup-verify-db.service

[Install]
WantedBy=timers.target
