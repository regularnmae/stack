# Quadlet unit for the nightly backup: an encrypted, deduplicating restic
# repository holding everything in $DATA_DIR that cannot be re-downloaded --
# the CLN identity and channel state, the Monero wallet, every token/secret,
# the nginx-proxy-manager config and TLS material, the BoltMesh database, and
# the status page's own state.
#
# The backup set is declared ONCE, as BACKUP_PATHS in stack.conf. deploy/install.sh
# renders it into the two places below (one Volume= per entry, and the restic path
# list in Exec=), and scripts/backup.sh derives its own mounts and arguments from
# the same array -- so adding a directory is a one-line edit in stack.conf, never
# an edit here. The rationale for each entry (and for what is deliberately absent)
# lives in that declaration.
#
# The BoltMesh database is backed up as a pg_dumpall, not as its raw cluster
# ($DATA_DIR/postgres): postgres-dump.service runs first (Wants=/After=
# below) and writes $DATA_DIR/postgres-dump/all.sql, which is what is mounted.
#
# The chain data (bitcoin/, monero/), the Electrum index (fulcrum/), searxng/
# and the metrics store are deliberately NOT backed up: they are huge and
# regenerable. Only the directories below are mounted, so restic never walks a
# 600 GB chain.
#
# This file is secret-free on purpose: the repository location and the restic
# password arrive through backup.env (EnvironmentFile), not as @PLACEHOLDERS@,
# so it renders like the other non-secret units. deploy/install.sh seeds it.
#
# It is a one-shot job, not a service: it has no [Install] and no
# RemainAfterExit, because backup.timer -- a plain systemd user unit, since
# Quadlet has no .timer type -- activates the backup.service this generates.
# (RemainAfterExit=yes would leave the job "started" and stop the timer from
# ever firing again.)
[Unit]
Description=Encrypted backup of the stack's irreplaceable state (restic)
# Wants=, not Requires=: the dump is best-effort, and a Postgres outage must
# never stop the restic run that protects the CLN identity and the wallet.
Wants=postgres-dump.service
After=postgres-dump.service

[Container]
ContainerName=stack-backup
Image=docker.io/restic/restic:0.19.1

# The repo location + password. deploy/install.sh writes this to
# $DATA_DIR/config/backup/backup.env (mode 600); it is never committed.
EnvironmentFile=@CONFIG_DIR@/backup/backup.env

# The backup set (BACKUP_PATHS in stack.conf), read-only, at paths that mirror
# $DATA_DIR so a restore can target the data dir directly. `:z` (shared) because
# lightningd, nginx-proxy-manager and tor mount these same directories.
@BACKUP_VOLUMES@

# The repository (writable) and restic's cache. The image's ENTRYPOINT is
# /usr/bin/restic, so it is replaced with a shell to allow init-if-missing and
# forget --prune in one run.
Volume=@BACKUP_DIR@:/repo:z
Volume=@DATA_DIR@/backup-cache:/cache:z
Entrypoint=/bin/sh
Exec=-c "restic snapshots >/dev/null 2>&1 || restic init; restic backup @BACKUP_PATHS@ --host stack --tag stack && restic forget --tag stack --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune"

[Service]
Type=oneshot
