# Quadlet unit for the nightly backup: an encrypted, deduplicating restic
# repository holding everything in $DATA_DIR that cannot be re-downloaded.
#
# The backup set is declared ONCE, as BACKUP_PATHS in stack.conf: install.sh
# renders it into the two places below (one Volume= per entry, and the restic
# path list in Exec=), and scripts/backup.sh derives its own mounts and
# arguments from the same array, so adding a directory is an edit there, never
# here.
#
# The three live databases are backed up as DUMPS, not as their files
# (postgres-dump.service and db-dump.service, both run first): a file-by-file
# copy of a database a daemon is writing is only crash-recoverable, and restic
# reads each file at its own instant.
#
# This file is secret-free on purpose: the repository location and the restic
# password arrive through backup.env (EnvironmentFile), not as @PLACEHOLDERS@.
#
# A one-shot job, not a service: no [Install] and no RemainAfterExit, which
# would leave the job "started" and stop backup.timer from ever firing again.
[Unit]
Description=Encrypted backup of the stack's irreplaceable state (restic)
# Wants=, not Requires=: the dumps are best-effort, and a database outage must
# never stop the restic run that protects the CLN identity and the wallet --
# the previous dump is still worth copying, and monitor.sh fails on a dump that
# stops being refreshed.
Wants=postgres-dump.service db-dump.service
After=postgres-dump.service db-dump.service

[Container]
ContainerName=stack-backup
Image=docker.io/restic/restic:0.19.1

# The repo location + password. install.sh writes this (mode 600); never
# committed.
EnvironmentFile=@CONFIG_DIR@/backup/backup.env

# The backup set (BACKUP_PATHS), read-only, at paths that mirror $DATA_DIR so a
# restore can target the data dir directly. `:z` (shared) because lightningd,
# nginx-proxy-manager and tor mount these same directories.
@BACKUP_VOLUMES@

# The repository (writable) and restic's cache. The image's ENTRYPOINT is
# /usr/bin/restic, so it is replaced with a shell to allow init-if-missing and
# forget --prune in one run.
Volume=@BACKUP_DIR@:/repo:z
Volume=@DATA_DIR@/backup-cache:/cache:z
Entrypoint=/bin/sh
# The --exclude list is BACKUP_EXCLUDES (the live databases and the root-owned
# IDS baseline) and the keep policy is BACKUP_RETENTION, both rendered from
# stack.conf so scripts/backup.sh can build the same flags for a hand run.
Exec=-c "restic snapshots >/dev/null 2>&1 || restic init; restic backup @BACKUP_PATHS@ @BACKUP_EXCLUDES@ --host stack --tag stack && restic forget --tag stack @BACKUP_RETENTION@ --prune"

[Service]
Type=oneshot
