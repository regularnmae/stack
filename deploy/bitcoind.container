# Quadlet unit for the Bitcoin Core full (archival) node. The RPC credentials
# live in bitcoin.conf under the data directory, never here.
[Unit]
Description=Bitcoin Core Node
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=bitcoind
Image=docker.io/lncm/bitcoind:v28.0
Network=npm-network.network

# No PublishPort on purpose: lightningd reaches it over the podman network and
# bitcoind dials out for P2P, while publishing would bind 0.0.0.0 on every
# interface, RPC included. Re-adding one is still refused: bitcoin.conf's
# rpcallowip is the podman subnet only.
#PublishPort=8333:8333
#PublishPort=8332:8332

# LNCM image uses /data internally. The :z bind mount is owned by the image uid
# (525287 on the host): edit bitcoin.conf through "podman exec bitcoind", and
# never chown -R, which locks bitcoind out of its own chainstate.
Volume=@DATA_DIR@/bitcoin:/data/.bitcoin:z

# Graceful stop, not podman's 10 s default: a SIGKILL mid-flush turns the next
# start into a verify or a reindex. TimeoutStopSec below must stay at least 30
# s above it -- systemd owns the cgroup and its own deadline kills the daemon
# first otherwise (docs/units.md, "A durable unit is stopped, not killed").
StopTimeout=120

# The lncm image ships no HEALTHCHECK, so without this podman reports "Up (no
# health status)" and verify.sh can only warn. A TCP connect, not an RPC call:
# an RPC probe enqueues work in bitcoind's queue and is starved by legitimate
# load (Fulcrum's index, the explorers, nbxplorer), and HealthOnFailure=kill
# turns that into a restart loop. "Alive but not answering RPC" is monitor.sh's
# job; busybox nc is in the image and rpcallowip still applies to loopback
# (docs/units.md, "Healthchecks follow a contract").
HealthCmd=nc -z 127.0.0.1 8332
HealthInterval=60s
HealthTimeout=15s
# The listener only binds after the block-index verify, which outlasts the 2m
# default start budget on the rotational data disk.
HealthStartPeriod=5m
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=150s

[Install]
WantedBy=default.target
