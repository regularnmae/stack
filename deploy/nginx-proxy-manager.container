# Quadlet unit for nginx-proxy-manager (NPM).
#
# Owned by this repo: NPM is the one service in the stack that had no home in
# version control before. deploy/install.sh renders this into
# ~/.config/containers/systemd/ and creates its data dirs under $DATA_DIR/npm.
#
# Publishes 80/443 (proxied sites) and 81 (the admin UI) on the LAN. Binding
# :80 rootless needs net.ipv4.ip_unprivileged_port_start<=80, which
# bootstrap.sh sets. Its SQLite database and TLS material live in
# $DATA_DIR/npm/{data,letsencrypt}; back those up -- install.sh never overwrites them.
#
# NPM IS the request path for every MCP server and for searxng: they bind
# 127.0.0.1 only, so NPM (reaching them by container name on npm-network) is
# the sole way in, terminating TLS. The MCP bearer tokens still gate them.
# Add a proxy host per server by hand in the admin UI (81); those hosts live
# in the SQLite database below, not in this repo.
[Unit]
Description=Nginx Proxy Manager
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=nginx-proxy-manager
Image=docker.io/jc21/nginx-proxy-manager:latest
Network=npm-network.network

# Port mappings: HTTP, HTTPS, and Admin Web UI.
PublishPort=80:80
PublishPort=443:443
PublishPort=81:81

# Volume mounts with :z (shared) for SELinux labelling. Shared, not private
# (:Z): the backup container mounts these same directories read-only, and a
# path one container labels private cannot be shared with another.
Volume=@DATA_DIR@/npm/data:/data:z
Volume=@DATA_DIR@/npm/letsencrypt:/etc/letsencrypt:z

# Environment settings.
Environment=DISABLE_IPV6=true

# The image ships no HEALTHCHECK; curl is present (wget is not). The admin UI
# on 81 answering proves NPM's nginx/node are alive rather than wedged.
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:81/
HealthInterval=30s
HealthStartPeriod=30s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
