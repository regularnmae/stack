# Quadlet unit for nginx-proxy-manager (NPM). install.sh renders it and creates
# its data dirs under $DATA_DIR/npm.
#
# Serves 80/443 (proxied sites) and 81 (the admin UI) on the LAN. Binding :80
# rootless needs net.ipv4.ip_unprivileged_port_start<=80, which bootstrap.sh
# sets. Its SQLite database and TLS material live in
# $DATA_DIR/npm/{data,letsencrypt}, which install.sh never overwrites.
#
# Network=host, and NOT a PublishPort, because a rootless published port is
# forwarded by rootlessport: a userspace proxy that dials the container over a
# fresh connection from inside the rootless namespace, so NPM saw its own
# address as $remote_addr for every request and real client IPs never reached
# its logs, its fail2ban surface or the X-Forwarded-For it sets on the way to
# the app tier. Only pasta preserves the source IP for a published port, and
# that is not in Rocky 10's podman 5.8 yet.
#
# On the host network NPM's own nginx binds :80/:443/:81, so the client's
# address is the client's. The price is reachability: NPM is no longer a peer
# on npm-network and cannot resolve a container name, so every unit it proxies
# to publishes on the host's loopback (PublishPort=127.0.0.1:...). Those binds
# are invisible to the LAN and NPM is still the only way in for a client.
#
# NPM IS the request path for every service: it terminates TLS and the MCP
# bearer tokens gate what is behind it. The proxy hosts are declared once in
# deploy/services.toml and reconciled by scripts/npm-hosts.sh through the admin
# API on 127.0.0.1:81; they live in the SQLite database below, not in this
# repo.
[Unit]
Description=Nginx Proxy Manager
After=network-online.target

[Container]
ContainerName=nginx-proxy-manager
Image=docker.io/jc21/nginx-proxy-manager:2.17.0
Network=host

# :z (shared) for SELinux labelling, not :Z: the backup container mounts these
# same directories read-only, and a path one container labels private cannot be
# shared.
Volume=@DATA_DIR@/npm/data:/data:z
Volume=@DATA_DIR@/npm/letsencrypt:/etc/letsencrypt:z

Environment=DISABLE_IPV6=true

# The image ships no HEALTHCHECK; curl is present (wget is not). The admin UI
# on 81 answering proves NPM's nginx and node are alive rather than wedged.
HealthCmd=curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:81/
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
