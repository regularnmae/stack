# The podman network the crypto node stack shares with the MCP servers and
# searxng. Vendored here (rather than left only on the host) so a fresh
# checkout has it. deploy/install.sh symlinks this into
# ~/.config/containers/systemd/, but only when no other repo has already
# provided it.
[Network]
NetworkName=npm-network

# Pin the subnet: tor.container pins --ip=10.89.0.240 and both
# bitcoin.conf (rpcallowip) and torrc (SocksPolicy) allow 10.89.0.0/24,
# so the network must not be assigned a different pool on a fresh host.
Subnet=10.89.0.0/24
Gateway=10.89.0.1
