# The rules vmalert evaluates, rendered by install.sh to
# $DATA_DIR/config/monitoring/vmalert/stack.yml.
#
# The split: scripts/monitor.sh reads the daemons and the host and writes the
# facts (stack_monitor_section, stack_monitor_detail_info, stack_sweep_timestamp)
# into node-exporter's textfile; these rules decide when a fact has been true
# long enough to speak; Alertmanager groups, repeats, inhibits and delivers.
# monitor.sh therefore owns no alert state at all, and a recovery is vmalert's
# transition to inactive -- not an endsAt the producer has to remember.
#
# Three things are load-bearing:
#   * the alert's identity is (alertname, service): the section is the label, and
#     the free text is fetched from stack_monitor_detail_info at notification
#     time. Putting the text in a label instead would make "disk 9% free" and
#     "disk 8% free" two different alerts, and every sweep would look like a
#     state change.
#   * the detail IS a label on a one-sample info series, so each distinct text is
#     a short-lived series. That is the price of putting the findings in the
#     mail: bounded by the number of sections, not by traffic, and nothing
#     queries or graphs it.
#   * `for:` damps onset and `keep_firing_for:` damps the reset. Both are
#     evaluated against the datasource, so a wedged VictoriaMetrics stops them --
#     the sweep's `alerting` section and the external heartbeat are what cover
#     that hole (docs/alerting.md).
#
# The reset half is not optional. A section only exists while something in it is
# bad, so a sweep with nothing to report makes it vanish, and without
# keep_firing_for that is an immediate "recovered" mail -- then a fresh alert on
# the next bad sweep. The same goes for a critical dropping back to warning: two
# different alerts, so the pair is a resolve plus a fire. keep_firing_for holds a
# firing alert through both, and a section that returns inside the window
# cancels the pending resolve (vmalert resets KeepFiringSince), so a flicker
# costs nothing at all.
groups:
  - name: stack
    # The scrape is 30s and the sweep rewrites its file every five minutes, so a
    # shorter interval only re-reads the same sample.
    interval: 30s
    rules:
      - alert: stack_critical
        expr: stack_monitor_section{severity="critical"} > 0
        # monitor.sh's hold-down, rendered from MONITOR_ALERT_FOR. Two sweeps is
        # the default: anything shorter is the flapping this exists to stop.
        for: @MONITOR_ALERT_FOR@s
        # The mirror of `for:`, rendered from MONITOR_ALERT_HOLD_S. A section
        # that clears for a sweep, or drops to warning, is not a recovery.
        keep_firing_for: @MONITOR_ALERT_HOLD_S@s
        labels:
          severity: critical
        annotations:
          summary: 'stack: {{ $labels.service }} is critical'
          description: '{{ with query (printf "stack_monitor_detail_info{service=%q}" $labels.service) }}{{ if . }}{{ . | first | label "detail" }}{{ end }}{{ end }}'

      - alert: stack_warning
        expr: stack_monitor_section{severity="warning"} > 0
        for: @MONITOR_ALERT_FOR@s
        keep_firing_for: @MONITOR_ALERT_HOLD_S@s
        labels:
          severity: warning
        annotations:
          summary: 'stack: {{ $labels.service }} is warning'
          description: '{{ with query (printf "stack_monitor_detail_info{service=%q}" $labels.service) }}{{ if . }}{{ . | first | label "detail" }}{{ end }}{{ end }}'

      # Four checks live here rather than in the sweep because their natural
      # shape is a rate, not a snapshot: monitor.sh writes the number, these
      # windows decide. Deciding them per sweep made the `host` and
      # `intrusion_detection` sections fire and resolve around every burst, since
      # a per-sweep delta is true for exactly one sweep.
      - alert: stack_unit_restarting
        expr: increase(stack_systemd_restarts[1h]) > @MONITOR_RESTART_MAX@
        for: @MONITOR_ALERT_FOR@s
        keep_firing_for: @MONITOR_ALERT_HOLD_S@s
        labels:
          severity: critical
        annotations:
          summary: 'stack: {{ $labels.unit }} is restarting'
          description: '{{ $labels.unit }} restarted {{ $value | humanize }} time(s) in the last hour (threshold @MONITOR_RESTART_MAX@) -- a crash loop that a green healthcheck hides. podman logs --tail 50 {{ $labels.unit }}'

      - alert: stack_disk_saturated
        expr: avg_over_time(stack_disk_util_pct[15m]) > @MONITOR_IO_UTIL_PCT@
        keep_firing_for: @MONITOR_ALERT_HOLD_S@s
        labels:
          severity: warning
        annotations:
          summary: 'stack: {{ $labels.device }} is saturated'
          description: '{{ $labels.device }} (holding @DATA_DIR@) averaged {{ $value | humanize }}% busy over 15 minutes (threshold @MONITOR_IO_UTIL_PCT@%): everything on it is queueing, including the chains.'

      - alert: stack_ids_noisy
        expr: max_over_time(stack_ids_alerts[15m]) > @MONITOR_IDS_ALERT_WARN@
        keep_firing_for: @MONITOR_ALERT_HOLD_S@s
        labels:
          severity: warning
        annotations:
          summary: 'stack: Suricata is reporting a burst'
          description: '{{ $value | humanize }} Suricata alert(s) in one report (threshold @MONITOR_IDS_ALERT_WARN@) within the last 15 minutes -- read @DATA_DIR@/ids/suricata/eve.json'

      - alert: stack_ssh_bruteforce
        expr: max_over_time(stack_ids_ssh_fail[15m]) > @MONITOR_SSH_FAIL_WARN@
        keep_firing_for: @MONITOR_ALERT_HOLD_S@s
        labels:
          severity: warning
        annotations:
          summary: 'stack: SSH authentication is being brute-forced'
          description: '{{ $value | humanize }} failed sshd auth line(s) in one IDS roll-up (six-minute window; threshold @MONITOR_SSH_FAIL_WARN@) within the last 15 minutes -- read journalctl -u sshd.service --since "-15 min"'

      # The producer's own liveness. A stopped monitor writes nothing, so its
      # last sample lives on in the store and `time() - value` keeps growing --
      # which is the only thing that notices a sweep that never ran on a host
      # where everything else still answers.
      - alert: stack_monitor_stale
        expr: (time() - stack_sweep_timestamp) > @MONITOR_SWEEP_MAX_AGE_S@
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: 'stack: the health sweep has stopped'
          description: 'stack_sweep_timestamp is {{ $value | humanizeDuration }} old (threshold @MONITOR_SWEEP_MAX_AGE_S@s); the sweep is not deciding anything, so only this rule and the external heartbeat can page.'
