# Quadlet unit for BTC RPC Explorer, the Bitcoin explorer served at
# $BTC_EXPLORER_HOST (NPM_HOSTS in stack.conf). It is stateless: the chain is
# read from the stack's own bitcoind over RPC and address history from Fulcrum
# over the Electrum protocol, so it adds no index and no data directory. Its
# configuration (the RPC credentials and the Fulcrum endpoint) is a
# secret-bearing EnvironmentFile seeded by install.sh.
#
# Not a .container.in: the credentials reach the container through
# EnvironmentFile=, not through Exec=, so Quadlet's no-expansion-in-Exec rule
# does not apply. install.sh still renders it, for @CONFIG_DIR@.
[Unit]
Description=BTC RPC Explorer (self-hosted Bitcoin blockchain explorer)
After=network-online.target npm-network-network.service bitcoind.service fulcrum.service
Wants=bitcoind.service fulcrum.service
Requires=npm-network-network.service

[Container]
ContainerName=btc-explorer
Image=localhost/btc-explorer:local
Network=npm-network.network
# Pin the IP: tor's onion target is this address, and tor validates a
# HiddenServicePort target when it starts -- before this container exists on a
# fresh host. Keep it unique (tor .240, boltmesh .241/.242, xmr-explorer .244).
IP=10.89.0.243

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8108 (NPM_HOSTS in stack.conf). The firewall opens nothing for it, so
# NPM (which terminates TLS) stays the only way in for a client.
PublishPort=127.0.0.1:8108:3002

# BTCEXP_BITCOIND_* (the RPC credentials) and BTCEXP_ELECTRUM_SERVERS (Fulcrum
# on npm-network). Seeded by deploy/install.sh from the stack's own secrets;
# never committed.
EnvironmentFile=@CONFIG_DIR@/btc-explorer/btc-explorer.env

# The app has no dedicated health endpoint; / renders the RPC-backed home page.
# curl is in the image (the final stage is Debian slim, which has no wget).
HealthCmd=curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:3002/
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
