# Quadlet unit for Fulcrum, the Electrum server the Bitcoin wallet connects to.
# It indexes the chain from bitcoind and speaks the Electrum protocol over raw
# TCP/TLS, not HTTP, so nginx-proxy-manager cannot front it: these are the only
# non-NPM ports opened on the LAN. Its database is large and regenerable, so it
# is outside the backup set. install.sh renders it (mode 600) because Exec=
# carries the bitcoind RPC password, like lightningd.
[Unit]
Description=Fulcrum Electrum server
After=network-online.target npm-network-network.service bitcoind.service
Wants=bitcoind.service
Requires=npm-network-network.service

[Container]
ContainerName=fulcrum
Image=docker.io/cculianu/fulcrum:v2.1.4
Network=npm-network.network

# Raw Electrum TCP and SSL, straight on the LAN: the one service not behind
# NPM, opened by bootstrap.sh from FIREWALL_PORTS. Do not give it an [npm.*]
# entry.
PublishPort=50001:50001
PublishPort=50002:50002

# fulcrum writes as container root, which is the host user under rootless
# podman (like cln/ and tor/), so install.sh only mkdirs this directory. The
# entrypoint generates a self-signed fulcrum.crt/.key here on first start.
Volume=@DATA_DIR@/fulcrum:/data:z

# -t/-s: plaintext and self-signed TLS for wallets. -a: admin RPC on loopback
# only (FulcrumAdmin; never published). --db_mem is deliberately left unset,
# i.e. Fulcrum's own autodetection (2048 MiB or 25% of RAM, whichever is
# smaller): a bigger block cache trades RAM for index throughput and can push
# the co-located daemons into swap. Fulcrum starts indexing as soon as
# bitcoind's RPC answers and serves wallets only once its own index has caught
# up.
Exec=Fulcrum -b bitcoind:8332 -u @BITCOIN_RPC_USER@ -p @BITCOIN_RPC_PASSWORD@ \
     -t 0.0.0.0:50001 -s 0.0.0.0:50002 -a 127.0.0.1:8000 \
     --polltime 5 --bd-timeout 120 --ts-format utc

# Graceful stop, not podman's 10 s default. Fulcrum writes undo info and its
# block DB on SIGTERM, and a SIGKILL mid-flush is what makes the next start log
# "shut down uncleanly, however undo info is missing from the DB" and reindex
# from scratch. TimeoutStopSec below stays 30 s above this (docs/units.md, "A
# durable unit is stopped, not killed", has the measurements).
StopTimeout=120

# The admin RPC does not listen until the initial index is caught up, so
# liveness is the process itself: the entrypoint execs Fulcrum as PID 1. An
# index probe here would report "unhealthy" through the multi-hour first sync.
# The functional check is outside the unit: verify.sh --deep compares its
# Electrum tip with bitcoind's, and monitor.sh alerts when the gap grows.
HealthCmd=sh -c 'grep -qx Fulcrum /proc/1/comm'
HealthInterval=60s
HealthTimeout=15s
HealthStartPeriod=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=150s

[Install]
WantedBy=default.target
