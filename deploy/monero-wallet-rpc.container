# Quadlet unit for the Monero wallet RPC. The wallet file password and the
# RPC login are NOT here: Exec= cannot expand environment variables, so they
# live in a config file passed with --config-file, which deploy/install.sh
# seeds (reusing what the previously-installed unit carried). That file lives
# under the data directory and is never committed.
[Unit]
Description=Monero Wallet RPC
After=monerod.service
Requires=monerod.service

[Container]
ContainerName=monero-wallet-rpc
Image=ghcr.io/sethforprivacy/simple-monero-wallet-rpc:latest
Network=npm-network.network

# The wallet RPC can open wallets and move funds, so it is
# protected twice over: authenticated (--rpc-login in the config
# file) AND published on host loopback only, mirroring tor's
# 127.0.0.1:9050-9051. It is never reachable from the LAN.
PublishPort=127.0.0.1:18083:18083

# Ownership NOTE: unlike monerod's entrypoint, this image's
# entrypoint checks /home/monero (image-owned, uid 1000)
# rather than the bind mount, so it will NOT re-own the dir
# for us. Pre-create it and chown to the mapped uid with:
#   podman unshare chown 1000:1000 %h/data/monero-wallet-rpc
# (host uid 525287 == in-container uid 1000 == monero user).
# The :z label is required: this host runs SELinux enforcing.
Volume=%h/data/monero-wallet-rpc:/home/monero/wallet:z

# NOTE: Exec= replaces the image CMD (--wallet-dir +
# --rpc-bind-port), so restate them, then add our flags.
# --password and --rpc-login are intentionally absent: they come
# from the config file (see the header above).
Exec=--wallet-file=/home/monero/wallet/mainnet \
     --rpc-bind-port=18083 \
     --daemon-address=monerod:18089 \
     --untrusted-daemon \
     --config-file=/home/monero/wallet/wallet.conf

# Image ships /healthcheck.sh: calls get_version over JSON-RPC
# with digest auth (creds/port auto-detected from PID 1).
HealthCmd=/healthcheck.sh
HealthInterval=60s
HealthStartPeriod=2m
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
