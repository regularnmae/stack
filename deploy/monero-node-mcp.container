# Quadlet unit for the MCP server itself. deploy/install.sh symlinks this
# into ~/.config/containers/systemd/, where quadlet turns it into
# monero-node-mcp.service.
[Unit]
Description=Monero Node MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service monerod.service
Requires=npm-network-network.service

[Container]
ContainerName=monero-node-mcp
Image=localhost/monero-node-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the node's optional restricted
# RPC credentials. Both live OUTSIDE this repo in ~/.config/monero-node-mcp/
# (mode 600), written by deploy/install.sh.
EnvironmentFile=%h/.config/monero-node-mcp/token.env
EnvironmentFile=%h/.config/monero-node-mcp/upstream.env

# Host 8102 -> container 8000 (the app's default). LAN-published like
# searxng-mcp on 8000; open 8102/tcp in firewalld.
PublishPort=8102:8000

HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=restart

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
