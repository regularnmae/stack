# Quadlet unit for the Monero node MCP server.
[Unit]
Description=Monero Node MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service monerod.service
Requires=npm-network-network.service

[Container]
ContainerName=monero-node-mcp
Image=localhost/monero-node-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the node's optional restricted RPC
# credentials. Both live OUTSIDE this repo in $DATA_DIR/config/monero-node-mcp/
# (mode 600), written by install.sh.
EnvironmentFile=@CONFIG_DIR@/monero-node-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/monero-node-mcp/upstream.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8102 -- it cannot resolve the container name -- while the app still
# listens on 8000 in its own namespace. The firewall opens nothing for it.
PublishPort=127.0.0.1:8102:8000

HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
