# Quadlet unit for the MCP server itself. deploy/install.sh renders this
# into ~/.config/containers/systemd/, where quadlet turns it into
# monero-node-mcp.service.
[Unit]
Description=Monero Node MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service monerod.service
Requires=npm-network-network.service

[Container]
ContainerName=monero-node-mcp
Image=localhost/monero-node-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the node's optional restricted
# RPC credentials. Both live OUTSIDE this repo in $DATA_DIR/config/monero-node-mcp/
# (mode 600), written by deploy/install.sh.
EnvironmentFile=@CONFIG_DIR@/monero-node-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/monero-node-mcp/upstream.env

# Loopback only: NPM is the sole path in (it reaches the container as
# monero-node-mcp:8000 on npm-network). Host 8102 -> container 8000 (the
# app's default). The loopback bind keeps verify.sh working; nothing on the
# LAN can reach 8102.
PublishPort=127.0.0.1:8102:8000

HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=restart

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
