# Quadlet unit for the BoltMesh API (FastAPI under gunicorn). The arq worker
# runs the same image (see boltmesh-worker.container).
[Unit]
Description=BoltMesh API (FastAPI/gunicorn)
After=network-online.target npm-network-network.service postgres.service
Requires=npm-network-network.service postgres.service

[Container]
ContainerName=boltmesh-backend
Image=localhost/boltmesh-backend:latest
Network=npm-network.network
# Pin the IP: tor's onion target is this address (see the frontend unit; keep
# the range unique, tor is .240).
IP=10.89.0.242

# Four env files, all OUTSIDE this repo under $DATA_DIR/config/boltmesh/ (mode
# 600), so no secret is committed:   db.env      -- POSTGRES_* and DATABASE_URL
# secrets.env -- the JWT signing keys and the bootstrap pepper   app.env     --
# operator-editable: URLs, CORS, OAuth, SMTP, TTLs   btcpay/backend.env -- the
# BTCPay store URL, runtime key, store id and webhook                  secret,
# written by configure.sh after the bootstrap job runs
EnvironmentFile=@CONFIG_DIR@/boltmesh/db.env
EnvironmentFile=@CONFIG_DIR@/boltmesh/secrets.env
EnvironmentFile=@CONFIG_DIR@/boltmesh/app.env
EnvironmentFile=@CONFIG_DIR@/btcpay/backend.env

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8105 -- it cannot resolve the container name -- and the firewall
# opens nothing for it, so NPM is the only way in. /health is deep (database +
# valkey), which is what verify.sh reads through net_curl.
PublishPort=127.0.0.1:8105:8000

# No HealthOnFailure (one of the two probed units without it), because this
# probe is DEEP: it includes postgres and valkey, a readiness question, not "is
# this process alive". Killing the app on a database blip turns one outage into
# a restart loop that pages as an app fault; verify.sh reads the same /health
# and pages on the cause.
# health-lint: HC008 deep health includes db+cache; verify.sh pages on it
HealthCmd=curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:8000/health
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=60s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
