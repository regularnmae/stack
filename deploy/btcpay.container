# Quadlet unit for BTCPay Server: the settlement engine for Lightning (BTC-LN)
# and Monero (XMR-CHAIN). It owns invoice amounts, destinations, expiry,
# confirmations and refundable late funds; the backend only calls its
# Greenfield API and receives its webhooks.
#
# The backend reaches it as btcpay:49392 on npm-network and the webhook goes to
# boltmesh-backend:8000, both internal. The store, webhook and API keys live in
# Postgres and are created by btcpay-bootstrap.container, not here.
[Unit]
Description=BTCPay Server (Lightning + Monero settlement)
After=network-online.target npm-network-network.service postgres.service nbxplorer.service lightningd.service
Requires=npm-network-network.service postgres.service nbxplorer.service

[Container]
ContainerName=btcpay
Image=docker.io/btcpayserver/btcpayserver:2.4.5
Network=npm-network.network

# Off the LAN, with nothing opened for it in the firewall: nginx-proxy-manager
# fronts it as BTCPAY_HOST, and an SSH tunnel to the same port still works.
PublishPort=127.0.0.1:49392:49392

Environment=BTCPAY_NETWORK=mainnet
Environment=BTCPAY_BIND=0.0.0.0:49392
Environment=BTCPAY_CHAINS=btc
# The public origin. The backend and the webhook use internal URLs, so this
# only affects links the UI renders -- but a wrong value redirects the browser
# there.
Environment=BTCPAY_EXTERNALURL=https://@BTCPAY_HOST@/
Environment=BTCPAY_BTCEXPLORERURL=http://nbxplorer:32838/
Environment="BTCPAY_POSTGRES=User ID=btcpay;Password=@BTCPAY_DB_PASSWORD@;Host=postgres;Port=5432;Database=btcpay;"
Environment=BTCPAY_BTCEXPLORERCOOKIEFILE=/nbxplorer/Main/.cookie
# The existing CLN node over its unix socket: BTCPay treats it as the server's
# internal node, which is what btcpay-bootstrap selects for BTC-LN.
Environment=BTCPAY_BTCLIGHTNING=type=clightning;server=unix:///clightning/bitcoin/lightning-rpc
Environment=BTCPAY_DATADIR=/datadir
# BTCPay refuses private webhook destinations unless allow-listed.
Environment=BTCPAY_SSRFEXCEPTIONS=boltmesh-backend:8000
# Monero plugin wiring: the dedicated plugin wallet, view-only once created.
Environment=BTCPAY_XMR_DAEMON_URI=http://monerod:18089
Environment=BTCPAY_XMR_WALLET_DAEMON_URI=http://monero-wallet-btcpay:18083
Environment=BTCPAY_XMR_WALLET_DAEMON_WALLETDIR=/xmr-wallet

# The datadir holds the data-protection keys and the rates cache; Plugins is
# bind-mounted separately because BTCPay always loads from
# ~/.btcpayserver/Plugins, not from DATADIR. nbxplorer is read-only -- only the
# cookie file is read -- and cln is `:z` (not `:Z`) because lightningd writes
# the same socket.
Volume=@DATA_DIR@/btcpay:/datadir:z
Volume=@DATA_DIR@/btcpay/Plugins:/root/.btcpayserver/Plugins:z
Volume=@DATA_DIR@/nbxplorer:/nbxplorer:ro,z
Volume=@DATA_DIR@/cln:/clightning:z
Volume=@DATA_DIR@/btcpay/xmr-wallet:/xmr-wallet:z

# Graceful stop, not podman's 10 s default: .NET flushes EF's pending writes
# and the data-protection keys on SIGTERM, and this datadir also holds the
# Monero plugin's wallet. TimeoutStopSec below stays 30 s above it
# (docs/units.md, "A durable unit is stopped, not killed").
StopTimeout=60

# The image ships no curl/wget; bash's /dev/tcp is the only bounded probe
# available, and it proves the HTTP listener is accepting. The deep check is
# the backend's /health, which calls the Greenfield API.
HealthCmd=/bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/49392'
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=2m
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=90s

[Install]
WantedBy=default.target
