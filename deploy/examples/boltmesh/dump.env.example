# Shape of $DATA_DIR/config/boltmesh/dump.env (mode 600), read only by
# deploy/postgres-dump.container (the pre-backup pg_dumpall).
#
# Deliberately separate from db.env: PGHOST/PGUSER in the postgres server's own
# environment would make its entrypoint's socket-based bootstrap dial TCP to a
# server that is not up yet.
PGHOST=postgres
PGUSER=vpnuser
PGPASSWORD=<same password as db.env>
