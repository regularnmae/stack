# Shape of $DATA_DIR/config/boltmesh/secrets.env (mode 600). deploy/install.sh
# generates one random value per key the first time (each at least 32 chars and
# distinct); it reuses the running container's values if one exists, so
# adopting a host keeps existing sessions and node tokens valid.
#
# Rotating any of these invalidates every session and node token.
SECRET_KEY=<64 hex chars>
REFRESH_SECRET_KEY=<64 hex chars>
NODE_SECRET_KEY=<64 hex chars>
BOOTSTRAP_SECRET_PEPPER=<64 hex chars>
