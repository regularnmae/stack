# Shape of $DATA_DIR/config/boltmesh/app.env (mode 600). deploy/install.sh seeds
# it once from the values in stack.conf; it is OPERATOR-EDITABLE and the only
# BoltMesh env file you normally touch. The app reads one flat environment, so
# the credentials you supply live here beside the URLs.
#
# Do not duplicate db.env / secrets.env / gateway.env values here.
#
# APP_ENV=prod: the app derives Secure + SameSite=None cookies from it (the SPA
# and the API are on different hosts) and stops loading any .env file.
APP_ENV=prod
APP_DEBUG=0
CACHE_URL=redis://valkey:6379/0

# Public URLs. API_BASE_URL is the base of every OAuth redirect_uri, so it must
# match the provider consoles and the nginx-proxy-manager proxy host.
API_BASE_URL=https://api.boltmesh.net
FRONTEND_URL=https://boltmesh.net
CORS_ALLOW_ORIGINS=https://boltmesh.net
COMPANY_NAME=BoltMesh VPN
TRUST_PROXY_HEADERS=1

# OAuth: register https://api.boltmesh.net/v1/auth/google/callback and
# https://api.boltmesh.net/v1/auth/github/callback in each provider's console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP for activation and password-reset mail.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=support@boltmesh.net
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
SUPPRESS_EMAIL=false
TEMPLATES_DIR=templates

# Node provisioning: the agent repo and a token that can read it.
GITHUB_REPO=boltmesh-labs/agent
GITHUB_TOKEN=
AWS_IID_ACCOUNT_ID=
AWS_IID_SIGNER_FINGERPRINTS=
MANUAL_BOOTSTRAP_SECRET_TTL_DAYS=30
SERVER_STALE_SECONDS=120
