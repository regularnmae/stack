# Shape of $DATA_DIR/config/boltmesh/gateway.env (mode 600). deploy/install.sh
# writes the real file on every run: the URL and the Monero login come from the
# stack's own daemons, and the rune is created on the run that finds lightningd
# reachable. Do not hand-edit -- it is machine-owned.
#
# The rune permits only getinfo, listinvoices and invoice, so BoltMesh can
# create and reconcile invoices but never move funds.
LIGHTNING_GATEWAY_URL=https://lightningd:3010
LIGHTNING_API_KEY=<rune>
LIGHTNING_TLS_INSECURE=1
MONERO_RPC_URL=http://monero-wallet-rpc:18083/json_rpc
MONERO_RPC_USER=<from $DATA_DIR/config/stack/secrets.env MONERO_RPC_LOGIN>
MONERO_RPC_PASSWORD=<from the same MONERO_RPC_LOGIN>
