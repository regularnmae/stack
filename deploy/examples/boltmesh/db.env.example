# Shape of $DATA_DIR/config/boltmesh/db.env (mode 600). deploy/install.sh
# writes the real file with a random password; the postgres unit reads
# POSTGRES_*, the backend and worker read DATABASE_URL (same password).
POSTGRES_DB=vpndb
POSTGRES_USER=vpnuser
POSTGRES_PASSWORD=<64 hex chars>
DATABASE_URL=postgresql+asyncpg://vpnuser:<same password>@postgres:5432/vpndb
