# Template for the Monero node's restricted-RPC credentials.
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/monero-node-mcp/upstream.env (mode 600), empty by default:
# monerod's restricted RPC normally runs with no login. Set these only if the
# node was started with --rpc-login. Carries no secret.
MONERO_RPC_USER=
MONERO_RPC_PASSWORD=
