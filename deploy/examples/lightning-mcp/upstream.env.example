# Template for the upstream Bitcoin Core RPC credentials.
#
# deploy/install.sh writes the real file to
# ~/.config/bitcoin-node-mcp/upstream.env (mode 600), reading rpcuser and
# rpcpassword out of the running `bitcoind` container's bitcoin.conf. Fill
# these in by hand only if that read failed. This example carries no secret.
BITCOIN_RPC_USER=btcuser
BITCOIN_RPC_PASSWORD=change-me
