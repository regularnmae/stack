# Template for the node's runes and TLS settings.
#
# deploy/install.sh writes the real file to ~/.config/lightning-mcp/node.env
# (mode 600), creating the runes with `lightning-cli createrune` when it can.
# Runes are secrets: they authorise RPC methods on the node. Carries none here.
#
# Both are base64 strings returned by the API.
LIGHTNING_RUNE=change-me
LIGHTNING_SPEND_RUNE=change-me-too
# clnrest serves a self-signed certificate. 1 skips verification (fine over
# the podman network); set LIGHTNING_CA_CERT to the node's cert.pem and this
# to 0 for a stricter setup.
LIGHTNING_TLS_INSECURE=1
# LIGHTNING_CA_CERT=/path/to/cert.pem
