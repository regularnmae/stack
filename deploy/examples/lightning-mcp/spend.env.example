# Template for the spending policy.
#
# deploy/install.sh writes the real file to ~/.config/lightning-mcp/spend.env
# (mode 600) with ENABLE_SPENDING=0. Nothing here is secret, but it decides
# whether real funds can move.
#
# With ENABLE_SPENDING=1 both caps must be positive (in satoshis) or the
# server refuses to start. MAINNET: this is real money.
ENABLE_SPENDING=0
MAX_PAYMENT_PER_CALL_SATS=10000
MAX_PAYMENT_PER_DAY_SATS=100000
