# Shape of $DATA_DIR/config/btcpay/backend.env (mode 600). deploy.sh writes the
# real file from $DATA_DIR/config/btcpay/bootstrap.env after the bootstrap has
# created the store, runtime key and webhook. Do not hand-edit.
#
# BTCPAY_URL is the internal Greenfield API on npm-network; the admin UI is
# reached over an SSH tunnel to 127.0.0.1:49392, not through this URL.
BTCPAY_URL=http://btcpay:49392
BTCPAY_API_KEY=<store-scoped runtime key>
BTCPAY_STORE_ID=<store id>
BTCPAY_WEBHOOK_SECRET=<webhook HMAC secret>
