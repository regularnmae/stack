# Template for $DATA_DIR/config/monitoring/alertmanager/alertmanager.yml -- the
# file deploy/alertmanager.container actually reads. install.sh copies it there
# once, mode 600, and never overwrites it: it carries the SMTP password.
#
# The split of responsibilities, because it decides where to look when a mail
# does not arrive:
#
#   scripts/monitor.sh   decides WHAT is wrong (it reads the daemons and the
#                        host directly) and writes it as metrics; it holds no
#                        alert state at all.
#   vmalert              decides WHEN a fault has lasted long enough: the rules
#                        in $DATA_DIR/config/monitoring/vmalert/stack.yml carry
#                        `for: MONITOR_ALERT_FOR`, and a transition back to
#                        inactive is the recovery it reports to Alertmanager.
#   this file            decides how alerts are grouped into one mail, what
#                        inhibits what, how often a still-firing alert repeats,
#                        and where it is delivered.
#
# Alertmanager does NOT watch this file (v0.34 has no config file watcher; there
# is no inotify fd on the process and an edit changes nothing until you say so).
# Reload it explicitly, then confirm the reload took:
#
#   curl -X POST http://127.0.0.1:9093/-/reload
#   curl -s http://127.0.0.1:9093/metrics | grep config_last_reload_successful
#
# Validate before saving (a bad config is refused and the old one keeps
# running, which is silent until you look):
#
#   podman exec alertmanager amtool check-config /etc/alertmanager/alertmanager.yml
#
# Prove the whole path once it is filled in:
#
#   scripts/monitor.sh --test      # one test mail now, one resolved a few minutes later

global:
  # vmalert reports a recovery as soon as its rule goes inactive, so an alert
  # that clears does not wait for this. The timeout only applies to an alert
  # nothing updates any more, and even then it is a backstop: vmalert stamps its
  # own endsAt on a firing alert (4x the group interval), so a dead vmalert is
  # resolved long before 24h -- and that false "recovered" is exactly what the
  # heartbeat exists for (docs/alerting.md).
  resolve_timeout: 24h

  # --- SMTP -----------------------------------------------------------------
  # smtp_smarthost is the SUBMISSION server, not the recipient's domain. That
  # distinction is the one people get wrong: a hostname that is not a mail
  # server (the recipient's domain, a bare IP with nothing on :587) fails to
  # connect, and a host that does accept mail without authentication gets the
  # mail spam-foldered or rejected, because a residential IP has no SPF record,
  # no DKIM signature and no matching PTR. A provider relay does all three for
  # you.
  #
  #   smtp.gmail.com:587        a Google account or Workspace mailbox. Needs an
  #                             App Password (2FA on); the normal account
  #                             password is refused. smtp_from must be the same
  #                             address, or a verified "send mail as" alias.
  #   smtp-relay.gmail.com:587  Workspace SMTP relay; requires SMTP AUTH or an
  #                             allowlisted source IP.
  #   smtp.example.com:465      implicit TLS; 465 is auto-detected, or force it
  #                             with smtp_force_implicit_tls: true.
  #
  # The same credentials in an Apprise `mailto://` URL had identical
  # requirements -- `mailto://user:app-password@gmail.com` is built on this very
  # server. Nothing about mail changes by moving it here.
  #
  # smtp_from: alerts@example.com
  # smtp_smarthost: smtp.gmail.com:587
  # smtp_auth_username: alerts@example.com
  # smtp_auth_password: 'app-password-here'
  # smtp_require_tls: true
  # smtp_hello: example.com     # EHLO name; some relays reject a bare hostname

# The stack's own mail templates, installed by deploy/install.sh on every run
# (the file carries no secret, so it is stack-owned; this config is not). They
# lead with the detail the sweep wrote instead of the stock template's label
# dump, and make each "; "-joined finding a bullet. Edit the repo copy in
# deploy/monitoring/alertmanager/stack.tmpl, not the installed one.
templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  # Email is the only channel. The severity split is where a phone or a chat
  # bridge would attach: critical and warning already have their own receivers
  # below, and both point at the same mailbox unless you separate them.
  #
  #   routes:
  #     - receiver: stack-phone
  #       matchers: [ severity = "critical" ]
  receiver: stack-email
  # Group by severity, not by alertname: one mail listing every critical check
  # beats fifteen mails. vmalert emits one alert per component/check (the
  # `component` and `check` labels) with that check's findings in its
  # description, so a group is still "everything wrong, by severity".
  group_by: ['severity']
  # An alert that resolves inside group_wait is never mailed at all. This is a
  # smaller flap damper behind the rules' `for:`; it also gives an inhibiting
  # root-cause alert time to arrive first.
  group_wait: 1m
  # The minimum gap between two notifications for the same group when its
  # content CHANGES (a new alert joins, one resolves). This is not a repeat: an
  # unchanged set is never re-mailed. 5m is the standard compromise: long enough
  # to batch a wave of related checks, short enough that a new critical is not
  # held for a quarter of an hour. A deploy still wants a silence, not a longer
  # interval.
  group_interval: 5m
  # A reminder while the alert is unchanged, not the paging delay. 24h is below
  # Alertmanager's 120h notification-log retention (a larger value is repeated at
  # the retention boundary instead, which is not the "never" it looks like) and
  # is a multiple of group_interval. The first mail is still the state change;
  # this only keeps a forgotten fault from disappearing from the inbox. The
  # warning route below overrides it: warnings are the half that flaps, so they
  # remind once every four days instead of once a day.
  repeat_interval: 24h
  routes:
    # Registrations are EVENTS, not faults (scripts/registrations.sh). Each one
    # is pushed once, with its own `signup` label, and carries an endsAt ten
    # minutes out so it cannot accumulate into an active alert list. That also
    # means the resolve is automatic -- which is why this sub-route exists: the
    # default receiver sends resolved mail, and every signup would produce a
    # second "recovered" message that means nothing.
    - receiver: stack-signups
      # One aggregation group per signup: `signup` is the unique id, so a new
      # registration is never folded into an earlier group's notification window,
      # and the notification log's restart dedupe (a group already notified
      # within repeat_interval) can never match a later signup. This is what made
      # the difference in testing: with the inherited group_by ['severity'], a
      # signup that arrived after a restart was held by the old group's nflog
      # entry until group_interval, and one that ended before that never mailed.
      group_by: ['signup']
      matchers:
        - severity = "info"

    # Warnings are batched and do not send a recovery. They are the half that
    # flaps -- a Suricata burst, a busy disk -- and a resolved mail for a warning
    # that returns in ten minutes is exactly the noise this route exists to stop.
    # 15m also lets a warning that clears on its own never mail at all. 96h is
    # under the 120h notification-log retention, like the default above.
    - receiver: stack-warnings
      matchers:
        - severity = "warning"
      group_wait: 15m
      group_interval: 1h
      repeat_interval: 96h

receivers:
  - name: stack-email
    # Uncomment and fill in once the SMTP settings above are set. Until then
    # Alertmanager accepts alerts and delivers nothing, on purpose: a fresh host
    # must not fail every sweep because a mailer is not configured yet.
    # monitor.sh reports that state as "alerting is inert" instead.
    #
    # email_configs:
    #   - to: you@example.com
    #     # A critical recovers visibly: the state change is the useful half.
    #     send_resolved: true
    #     # The templates in deploy/monitoring/alertmanager/stack.tmpl. The
    #     # installed copy is stack-owned (install.sh overwrites it); edit the
    #     # repo one.
    #     text: '{{ template "stack.email.text" . }}'
    #     html: '{{ template "stack.email.html" . }}'
    #     headers:
    #       Subject: '{{ template "stack.email.subject" . }}'

  # Warnings, from the sub-route above. Same mailbox unless you point `to:`
  # somewhere else; the route's batching and the missing recovery mail are the
  # whole point, so keep send_resolved false.
  - name: stack-warnings
    # email_configs:
    #   - to: you@example.com
    #     send_resolved: false
    #     text: '{{ template "stack.email.text" . }}'
    #     html: '{{ template "stack.email.html" . }}'
    #     headers:
    #       Subject: '{{ template "stack.email.subject" . }}'

  # Signature-less events (BoltMesh signups today). Same mailbox unless you want
  # them apart -- point `to:` somewhere else and they will not mix with pages.
  # send_resolved MUST stay false: the alert ends by its own endsAt, and a
  # resolved mail per signup is exactly the noise this route exists to stop.
  - name: stack-signups
    # email_configs:
    #   - to: you@example.com
    #     send_resolved: false

# Inhibition is component-scoped. `instance` is the same on every alert on a
# single-host stack (they all share instance=node-exporter:9100), so using it as
# the `equal` key would let one critical mute every warning, including an
# unrelated failed unit. A critical mutes only the same component/check; a
# component that is down mutes its own dependent checks, which is what turns one
# dead service into one page instead of a unit fault plus a verify failure plus
# a 502.
inhibit_rules:
  - name: critical-mutes-warning-same-check
    source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['component', 'check']

  - name: component-down-mutes-its-checks
    source_matchers:
      - alertname = "StackComponentDown"
    target_matchers:
      - alertname =~ "StackCheck(Critical|Warning)"
    equal: ['component']

  - name: component-down-mutes-restart-loop
    source_matchers:
      - alertname = "StackComponentDown"
    target_matchers:
      - alertname = "StackRestartLoop"
    equal: ['component']

  # The crash loop is the root cause; the chain-tip/verify/HTTP checks are its
  # symptoms. One critical page, not a warning plus a page for the same unit.
  - name: restart-loop-mutes-its-checks
    source_matchers:
      - alertname = "StackRestartLoop"
    target_matchers:
      - alertname =~ "StackCheck(Critical|Warning)"
    equal: ['component']

  - name: component-unhealthy-mutes-warning-checks
    source_matchers:
      - alertname = "StackComponentUnhealthy"
    target_matchers:
      - alertname = "StackCheckWarning"
    equal: ['component']

  # NPM is the shared root cause of every vhost probe. Its component is not the
  # vhost's upstream, so it needs a rule of its own.
  - name: proxy-down-mutes-public-surface
    source_matchers:
      - alertname = "StackComponentDown"
      - component = "nginx-proxy-manager"
    target_matchers:
      - alertname =~ "StackCheck(Critical|Warning)"
      - check =~ "http|hsts|redirect"

  # The chain's dependency edges. bitcoind down explains the electrum/explorer
  # symptoms; monerod down explains the wallet/explorer symptoms. Keep these
  # lists in step with deploy/services.toml's needs_nodes declarations.
  - name: bitcoind-down-mutes-chain
    source_matchers:
      - alertname = "StackComponentDown"
      - component = "bitcoind"
    target_matchers:
      - alertname =~ "StackCheck(Critical|Warning)"
      - component =~ "fulcrum|lightningd|btc-explorer|xmr-explorer|btcpay|nbxplorer"

  - name: monerod-down-mutes-monero
    source_matchers:
      - alertname = "StackComponentDown"
      - component = "monerod"
    target_matchers:
      - alertname =~ "StackCheck(Critical|Warning)"
      - component =~ "monero-wallet-btcpay|xmr-explorer"

  # The restore drill and the unit that runs it are one fault: backup-verify.service
  # exits non-zero because the restored dump is stale, and the monitor carries
  # both facts. The critical names the fault; the unit warning is the same thing
  # one layer up, so it is muted while the critical is active.
  - name: backup-failure-mutes-its-verifier
    source_matchers:
      - alertname = "StackCheckCritical"
      - component = "backup"
    target_matchers:
      - alertname = "StackCheckWarning"
      - component = "backup-verify"
