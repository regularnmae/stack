# Template for $DATA_DIR/config/monitoring/alertmanager/alertmanager.yml -- the
# file deploy/alertmanager.container actually reads. install.sh copies it there
# once, mode 600, and never overwrites it: it carries the SMTP password.
#
# The split of responsibilities, because it decides where to look when a mail
# does not arrive:
#
#   scripts/monitor.sh   decides WHAT is wrong (it reads the daemons and the
#                        host directly) and writes it as metrics; it holds no
#                        alert state at all.
#   vmalert              decides WHEN a fault has lasted long enough: the rules
#                        in $DATA_DIR/config/monitoring/vmalert/stack.yml carry
#                        `for: MONITOR_ALERT_FOR`, and a transition back to
#                        inactive is the recovery it reports to Alertmanager.
#   this file            decides how alerts are grouped into one mail, what
#                        inhibits what, how often a still-firing alert repeats,
#                        and where it is delivered.
#
# Alertmanager does NOT watch this file (v0.34 has no config file watcher; there
# is no inotify fd on the process and an edit changes nothing until you say so).
# Reload it explicitly, then confirm the reload took:
#
#   curl -X POST http://127.0.0.1:9093/-/reload
#   curl -s http://127.0.0.1:9093/metrics | grep config_last_reload_successful
#
# Validate before saving (a bad config is refused and the old one keeps
# running, which is silent until you look):
#
#   podman exec alertmanager amtool check-config /etc/alertmanager/alertmanager.yml
#
# Prove the whole path once it is filled in:
#
#   scripts/monitor.sh --test      # one warning mail now, one resolved in ~2 min

global:
  # vmalert reports a recovery as soon as its rule goes inactive, so an alert
  # that clears does not wait for this. The timeout only applies to an alert
  # nothing updates any more, and even then it is a backstop: vmalert stamps its
  # own endsAt on a firing alert (4x the group interval), so a dead vmalert is
  # resolved long before 24h -- and that false "recovered" is exactly what the
  # heartbeat exists for (docs/alerting.md).
  resolve_timeout: 24h

  # --- SMTP -----------------------------------------------------------------
  # smtp_smarthost is the SUBMISSION server, not the recipient's domain. That
  # distinction is the one people get wrong: a hostname that is not a mail
  # server (the recipient's domain, a bare IP with nothing on :587) fails to
  # connect, and a host that does accept mail without authentication gets the
  # mail spam-foldered or rejected, because a residential IP has no SPF record,
  # no DKIM signature and no matching PTR. A provider relay does all three for
  # you.
  #
  #   smtp.gmail.com:587        a Google account or Workspace mailbox. Needs an
  #                             App Password (2FA on); the normal account
  #                             password is refused. smtp_from must be the same
  #                             address, or a verified "send mail as" alias.
  #   smtp-relay.gmail.com:587  Workspace SMTP relay; requires SMTP AUTH or an
  #                             allowlisted source IP.
  #   smtp.example.com:465      implicit TLS; 465 is auto-detected, or force it
  #                             with smtp_force_implicit_tls: true.
  #
  # The same credentials in an Apprise `mailto://` URL had identical
  # requirements -- `mailto://user:app-password@gmail.com` is built on this very
  # server. Nothing about mail changes by moving it here.
  #
  # smtp_from: alerts@example.com
  # smtp_smarthost: smtp.gmail.com:587
  # smtp_auth_username: alerts@example.com
  # smtp_auth_password: 'app-password-here'
  # smtp_require_tls: true
  # smtp_hello: example.com     # EHLO name; some relays reject a bare hostname

route:
  # One receiver for now: email is the only channel. The shape to grow into is
  # a sub-route per severity -- critical to a phone, warning to a mailbox:
  #
  #   routes:
  #     - receiver: stack-phone
  #       matchers: [ severity = "critical" ]
  receiver: stack-email
  # Group by severity, not by alertname: one mail listing every critical check
  # beats fifteen mails. vmalert emits one alert per check section (the `service`
  # label) with every finding for that section in its description, so a group is
  # still "everything wrong, by severity".
  group_by: ['severity']
  # An alert that resolves inside group_wait is never mailed at all. This is a
  # smaller flap damper behind the rules' `for:`; it only has to absorb a
  # resolution already in flight.
  group_wait: 30s
  # The minimum gap between two notifications for the same group when its
  # content CHANGES (a new alert joins, one resolves). This is not a repeat: an
  # unchanged set is never re-mailed. 10m coalesces two sections flapping in the
  # same window into one mail.
  group_interval: 10m
  # Nagios' `notification_interval 0`: notify on the state change, never again
  # while the alert is unchanged. Alertmanager rejects 0 ("repeat_interval
  # cannot be zero"), so this is a duration longer than any incident -- one
  # problem mail and one recovery mail per episode, and nothing in between. The
  # trade-off is that a lost problem mail is never re-sent; verify the path with
  # scripts/monitor.sh --test rather than relying on a reminder.
  repeat_interval: 8760h
  routes:
    # Registrations are EVENTS, not faults (scripts/registrations.sh). Each one
    # is pushed once, with its own `signup` label, and carries an endsAt ten
    # minutes out so it cannot accumulate into an active alert list. That also
    # means the resolve is automatic -- which is why this sub-route exists: the
    # default receiver sends resolved mail, and every signup would produce a
    # second "recovered" message that means nothing.
    - receiver: stack-signups
      # One aggregation group per signup: `signup` is the unique id, so a new
      # registration is never folded into an earlier group's notification window,
      # and the notification log's restart dedupe (a group already notified
      # within repeat_interval) can never match a later signup. This is what made
      # the difference in testing: with the inherited group_by ['severity'], a
      # signup that arrived after a restart was held by the old group's nflog
      # entry until group_interval, and one that ended before that never mailed.
      group_by: ['signup']
      matchers:
        - severity = "info"

receivers:
  - name: stack-email
    # Uncomment and fill in once the SMTP settings above are set. Until then
    # Alertmanager accepts alerts and delivers nothing, on purpose: a fresh host
    # must not fail every sweep because a mailer is not configured yet.
    # monitor.sh reports that state as "alerting is inert" instead.
    #
    # email_configs:
    #   - to: you@example.com
    #     # Without this, recoveries are silent: Alertmanager's default is false.
    #     send_resolved: true
    #     # The default HTML/text templates list every alert in the group with
    #     # its annotations. Customise with `html:` / `text:` if you want.

  # Signature-less events (BoltMesh signups today). Same mailbox unless you want
  # them apart -- point `to:` somewhere else and they will not mix with pages.
  # send_resolved MUST stay false: the alert ends by its own endsAt, and a
  # resolved mail per signup is exactly the noise this route exists to stop.
  - name: stack-signups
    # email_configs:
    #   - to: you@example.com
    #     send_resolved: false

# Inhibition: one real fault usually produces several warnings -- a full disk
# makes every chain look stale, a dead node makes every MCP check look slow. A
# critical on the same instance mutes the warnings. `instance` comes from the
# node scrape the facts arrive through (all of the sweep's series share it), so
# the rule holds whatever that scrape is relabelled to.
inhibit_rules:
  - name: critical-mutes-warnings
    source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['instance']
