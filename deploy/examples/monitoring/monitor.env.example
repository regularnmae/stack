# The monitoring alerts, the dead-man's-switch heartbeat and every threshold the
# sweep compares against.
#
# deploy/install.sh copies this file verbatim to
# $DATA_DIR/config/monitoring/monitor.env (mode 600) and never overwrites it
# afterwards, so on a deployed host EDIT THE INSTALLED COPY. deploy/monitor.service
# reads it via EnvironmentFile and scripts/monitor.sh reads it too (so the script
# behaves the same when run by hand). Every key falls back to the default in
# scripts/monitor.sh when it is unset or non-numeric, which is what lets a file
# written before a check existed still monitor.
#
# The SMTP credentials are NOT here: they live in
# $DATA_DIR/config/monitoring/alertmanager/alertmanager.yml, which Alertmanager
# reads (and which install.sh seeds from
# deploy/examples/monitoring/alertmanager.yml.example). This file only says
# where Alertmanager is and how long an alert must hold before it is sent.

# Where the alert set is pushed. Alertmanager groups, repeats, inhibits, silences
# and delivers it (see deploy/alertmanager.container); this script only decides
# what is wrong. Default when unset: http://127.0.0.1:9093, the loopback publish
# install.sh's unit declares. `off` disables the push entirely and leaves alerts
# in the journal, which is the behaviour this stack had before Alertmanager.
MONITOR_ALERTMANAGER_URL=http://127.0.0.1:9093

# The dead-man's switch: a heartbeat a plain curl hits on every run -- the URL
# on success, "<url>/fail" with the failure list on failure. A healthchecks.io
# ping URL (https://hc-ping.com/<uuid>) is the usual choice; set that check's
# period to your timer interval (5 minutes). This is the ONLY thing that notices
# when the whole host is down, because the monitor cannot report from a host
# that is not running. It also fails when the alert push fails or Alertmanager
# reports failed deliveries, so a broken mail path cannot look healthy. Empty
# disables it.
MONITOR_PING_URL=

# While a chain is still syncing (bitcoind in initial block download, or
# monerod not synchronized), treat the chain checks as a warning rather than a
# page -- a fresh deploy syncs for hours to days. 1 (default) or 0.
MONITOR_GRACE_SYNC=1

# Extra arguments for the verify.sh base sweep. Defaults to --deep (one read
# tool per MCP endpoint).
MONITOR_VERIFY_ARGS=--deep

# 1 on a host deployed with ./deploy.sh --skip-daemons: it runs none of
# stack.conf's CHAIN_UNITS, so the chain-daemon section and the vhosts whose
# upstream is one of them would fail on every sweep for a state the operator
# chose. Set here rather than by adding --no-nodes to MONITOR_VERIFY_ARGS above
# -- this appends that flag itself, so the two cannot disagree.
MONITOR_SKIP_NODES=0

# --- thresholds -------------------------------------------------------------
# The host checks. Each is compared as shown; leave a value empty and
# scripts/monitor.sh falls back to the default in parentheses, so a host whose
# monitor.env predates these keys still monitors.

# Per cent still free on $DATA_DIR and on / (10). Both also fail on the inode
# table, which fills at exactly the wrong moment on a directory of many small
# files.
MONITOR_DISK_FREE_PCT=10
MONITOR_INODES_FREE_PCT=5

# Per cent of wall time the disk holding $DATA_DIR may be busy, sampled over 3
# seconds (90). Space is not the whole story: a disk that is 100% busy at a few
# MB/s is why every chain crawls, and df shows it as perfectly healthy.
MONITOR_IO_UTIL_PCT=90

# Hours since the newest restic snapshot (36). A timer that fires regularly
# proves nothing about the repository; this is the check that fails when the
# backup has been silently broken for a day and a half.
MONITOR_BACKUP_MAX_AGE_H=36

# Hours since the last SUCCESSFUL restore drill (192, i.e. eight days for a
# weekly run). scripts/backup.sh verify restores a snapshot into a scratch
# directory, checks every backed-up path came back and records the verdict in
# $DATA_DIR/audit/backup-verify.status. The age is keyed on the last success, so
# a drill that keeps skipping (no disk space, a set larger than
# BACKUP_VERIFY_MAX_MB) fails this check instead of looking healthy.
MONITOR_BACKUP_VERIFY_MAX_AGE_H=192

# Hours since the last SUCCESSFUL database drill (1080, i.e. 45 days for a
# monthly run). scripts/backup.sh verify-db restores just the snapshot's
# postgres-dump and replays it into a throwaway cluster -- the one thing the
# weekly restore drill cannot prove -- and records the verdict in
# $DATA_DIR/audit/backup-verify-db.status. Same rule as the drill above: keyed on
# the last success, so a run of skips (a registry the pull cannot reach, a locked
# repository, no disk space) fails this check instead of looking healthy. One
# missed monthly run is enough to page, which is the point: the dump is the only
# copy of the app tier's data.
MONITOR_BACKUP_VERIFY_DB_MAX_AGE_H=1080

# Hours since the oldest pre-backup database dump (36). restic does not copy the
# live npm/data/database.sqlite, uptime-kuma/mariadb or postgres/ tree -- it
# copies the dumps scripts/db-dump.sh and postgres-dump.service write just before
# each run. A dump job that fails leaves the previous copy in place, so the
# backup keeps succeeding with stale data; this is the check that notices.
MONITOR_DUMP_MAX_AGE_H=36

# Days of validity left on the soonest-expiring certificate
# nginx-proxy-manager holds (14). NPM renews by itself and says nothing when it
# cannot.
MONITOR_CERT_MIN_DAYS=14

# systemd restarts of any stack unit allowed between two sweeps (3). podman
# reports a crash-looping container as healthy again between restarts, so this
# is counted against the previous sweep rather than read off a status line.
MONITOR_RESTART_MAX=3

# Seconds before $DATA_DIR/monitoring/textfile/stack.prom counts as stale (300).
# The collector is a 60s timer, so five missed ticks is a real failure -- and a
# dead collector is invisible any other way.
MONITOR_METRICS_MAX_AGE_S=300

# Seconds before the newest entry in the log store counts as stale (900). vector
# ships the journal continuously, so 15 minutes is a stopped pipeline, not lag --
# the failure that matters is the silent one, where every unit reads "active"
# and nothing is arriving. This is the sweep's only query against a store.
MONITOR_LOGS_MAX_AGE_S=900

# Packets the busiest NIC may drop or error between two sweeps (100). Read from
# /sys/class/net and delta'd, like the restart counters: a carrier dropping
# packets is invisible to every chain check (they only see a slow sync) and to
# node-exporter's counters until somebody looks. A warn, not a failure.
MONITOR_NET_DROP=100

# Degrees Celsius the hottest hwmon sensor may read (85). A warn: the box is
# headless, a one-off spike (a compile, a busy sweep) is noise, and a climbing
# trend is already graphed by node-exporter from the same sysfs.
MONITOR_TEMP_MAX=85

# --- the chains -------------------------------------------------------------
# The peer floor is deliberately 1: any count below it (i.e. zero) fails, and
# during initial block download zero peers means the sync is stalled, not
# protected -- there is no MONITOR_GRACE_SYNC grace here.
MONITOR_BTC_MIN_PEERS=1

# Bytes in bitcoind's mempool, in MB, that make the sweep *warn* (250). Not a
# failure: Core's default maxmempool is 300 MB and it grows well into a fee
# storm before rejecting, so this is the "look at the fees" signal.
MONITOR_MEMPOOL_MB=250

# Blocks monerod may sit behind its own target_height while reporting
# synchronized (3). A synchronized node is normally 0-1 blocks out; more means a
# wedged-but-alive RPC surface serving a stale chain. MONITOR_GRACE_SYNC covers
# the unsynchronized case, like the other chain checks.
MONITOR_XMR_LAG_BLOCKS=3

# Blocks Fulcrum's Electrum index may sit behind bitcoind before it is a failure
# (12). A healthy Fulcrum polls bitcoind every 5s, so it is 0-1 block behind; this
# is the "stopped following" threshold, not a "slightly late" one. Its healthcheck
# only proves the process is alive, so this -- and verify.sh's Electrum probe --
# is what notices an index that wedged while everything looked green.
MONITOR_FULCRUM_LAG_BLOCKS=12

# Minutes the IDS roll-up may go without a successful run before the sweep fails
# (20). scripts/ids.sh runs from ids.timer every five minutes; a sensor whose
# unit reads "active" while the engine inside has stopped turning is exactly what
# this catches.
MONITOR_IDS_MAX_AGE_MIN=20

# Suricata alerts since the last roll-up that make the sweep *warn* (20). A warn,
# not a failure: one alert needs a human to read it, and a page per alert is how
# alerts stop being read. The rate is in VictoriaMetrics (stack_ids_alerts).
MONITOR_IDS_ALERT_WARN=20

# Minutes the bouncer may go without a successful apply before the sweep fails
# (5). stack-bouncer.timer runs every minute; detects the one state where the host
# looks protected and is not -- detection healthy, nothing enforced.
MONITOR_BOUNCER_MAX_AGE_MIN=5

# Minutes the audit report may go without a run before the sweep fails (20).
# stack-audit.timer runs every five minutes; it carries both the auditd watches
# and the persistence-directory hash diff.
MONITOR_AUDIT_MAX_AGE_MIN=20

# Minutes the BoltMesh signup watcher may go without a successful run before the
# sweep warns (20). registrations.timer runs every minute and mails one alert per
# signup (scripts/registrations.sh); a dead watcher is not a site fault, so it is
# a warning -- but it is the only path that says somebody registered.
MONITOR_REGISTRATIONS_MAX_AGE_MIN=20

# Seconds a failing check must stay failing before it is pushed at all (600 =
# two sweeps). This is the flap damper: Alertmanager only sees what is pushed at
# it, so a check that fails every other sweep would otherwise mail on every
# sweep. Anything bad for less than this costs a journal line, not an email. A
# recovery is never delayed -- the next sweep that sees it clear resolves the
# alert explicitly, ending the silence. The one exception is the `alerting`
# section itself (a broken alert path), which is pushed immediately.
MONITOR_ALERT_FOR=600
