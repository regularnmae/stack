# Template for the Electrum endpoint this server reads.
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/fulcrum-mcp/upstream.env (mode 600). Fulcrum is reachable
# only on npm-network and the Electrum protocol has no authentication of its
# own, so this file carries no secret. The app defaults to the same URL; the
# file exists so the endpoint has one declared owner.
FULCRUM_URL=tcp://fulcrum:50001
# Optional call timeout in seconds (the app default is 30).
# FULCRUM_TIMEOUT=30
