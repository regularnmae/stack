# Template for BTC RPC Explorer's environment (deploy/btc-explorer.container).
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/btc-explorer/btc-explorer.env (mode 600), deriving the RPC
# credentials from the stack's own node secrets. Fill these in by hand only if
# that failed. This example carries no secret.
#
# The explorer reads bitcoind over RPC and Fulcrum over the Electrum protocol
# (address history); it keeps no index and no data directory of its own.
BTCEXP_HOST=0.0.0.0
BTCEXP_PORT=3002
BTCEXP_BITCOIND_HOST=bitcoind
BTCEXP_BITCOIND_PORT=8332
BTCEXP_BITCOIND_USER=btcuser
BTCEXP_BITCOIND_PASS=change-me
BTCEXP_ADDRESS_API=electrum
BTCEXP_ELECTRUM_SERVERS=tcp://fulcrum:50001
BTCEXP_SECURE_SITE=true
BTCEXP_PRIVACY_MODE=true
BTCEXP_NO_RATES=true
BTCEXP_SLOW_DEVICE_MODE=true
BTCEXP_RPC_ALLOWALL=false
# Any username, this password. Empty = public (NPM still terminates TLS).
BTCEXP_BASIC_AUTH_PASSWORD=
