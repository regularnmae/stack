# Template for the MCP server's bearer tokens.
#
# deploy/install.sh writes the real file to
# ~/.config/monero-wallet-mcp/token.env (mode 600). Two tokens:
#   MONERO_MCP_TOKEN        -- read access (the endpoint), no spending
#   MONERO_MCP_SPEND_TOKEN  -- additionally required to call spend tools
# This example is the only token-shaped thing in the repo; no secret.
#
# Clients send the value as:
#   Authorization: Bearer <token>
MONERO_MCP_TOKEN=change-me
MONERO_MCP_SPEND_TOKEN=change-me-too
