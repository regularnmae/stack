# Template for the upstream monero-wallet-rpc login.
#
# deploy/install.sh writes the real file to
# ~/.config/monero-wallet-mcp/upstream.env (mode 600), reading --rpc-login
# from the running monero-wallet-rpc container. Carries no secret.
MONERO_WALLET_RPC_USER=monero
MONERO_WALLET_RPC_PASSWORD=change-me
