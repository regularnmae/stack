# Shape of $DATA_DIR/config/monero-wallet-mcp/upstream.env (mode 600).
# deploy/install.sh writes the real file on every run.
#
# The upstream is BTCPay's view-only plugin wallet: the plugin hardcodes empty
# credentials, so there is no login to set. The wallet has no spend key, so the
# MCP's transfer/sweep tools cannot move funds.
MONERO_WALLET_RPC_URL=http://monero-wallet-btcpay:18083/json_rpc
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
