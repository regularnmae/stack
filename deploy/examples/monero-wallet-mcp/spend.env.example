# Template for the spending policy.
#
# deploy/install.sh writes the real file to
# ~/.config/monero-wallet-mcp/spend.env (mode 600) with ENABLE_SPENDING=0.
# Nothing here is secret, but it decides whether real funds can move.
#
# With ENABLE_SPENDING=1 both caps must be positive (in XMR) or the server
# refuses to start. MAINNET: this is real money.
ENABLE_SPENDING=0
MAX_SPEND_PER_CALL=1
MAX_SPEND_PER_DAY=5
# Optional comma-separated destination allowlist; empty allows any address.
ALLOWED_DESTINATIONS=
