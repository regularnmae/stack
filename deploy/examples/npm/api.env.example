# Template for the nginx-proxy-manager admin API credentials.
#
# deploy/install.sh writes the real file to $DATA_DIR/config/npm/api.env (mode
# 600). scripts/npm-mcp-hosts.sh reads it to create the one proxy host that
# serves every MCP server as https://<MCP_HOST>/<prefix> (the host and the
# prefixes come from MCP_HOST/MCP_HOSTS in stack.conf). Never committed.
#
# The admin login, as you set it on your first visit to the UI on port 81.
# Preferred over a token: a bearer token minted from it is short-lived, and the
# script refreshes it on every run.
NPM_EMAIL=
NPM_PASSWORD=
#
# Optional: an API token created in the UI (Settings -> API Tokens). Use it only
# if you would rather not store the admin login. It expires; after that, a
# re-run needs a fresh one.
NPM_TOKEN=
#
# Optional: the id of an existing certificate to attach (SSL Certificates in the
# UI; the id is in the URL of that certificate's page). Empty means "reuse a
# Let's Encrypt certificate that already covers the host, or request a new one".
NPM_CERT_ID=
#
# Request a Let's Encrypt certificate for the host when none covers it (1/0).
# The host's DNS must point here and port 80 must reach this machine for the
# HTTP-01 challenge -- the same requirement as the BoltMesh hosts.
NPM_REQUEST_CERT=1
