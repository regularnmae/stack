# Template for the CrowdSec key the MCP server reads decisions with.
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/crowdsec-mcp/lapi.env (mode 600), rendered from
# CROWDSEC_MCP_BOUNCER_KEY in $DATA_DIR/config/stack/secrets.env -- the same
# value deploy/crowdsec.container.in registers in the LAPI as the `mcp`
# bouncer. Unlike the token next to it this file is NOT seed-once: it is
# derived, so install.sh rewrites it whenever the two disagree.
#
# It must be a BOUNCER key (`cscli bouncers add`). Never put a machine
# password here: a machine can also create and delete decisions and push
# alerts -- i.e. ban and unban -- which is exactly the authority this server is
# built to not hold.
CROWDSEC_LAPI_KEY=change-me
