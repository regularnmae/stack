# Template for the Uptime-Kuma admin credentials.
#
# deploy/install.sh writes the real file to $DATA_DIR/config/uptime-kuma/api.env
# (mode 600). scripts/kuma-monitors.sh reads it to reconcile the status page's
# monitors -- declared in KUMA_MONITORS in stack.conf -- and to create + publish
# the public status page. Never committed.
#
# The username and password the setup wizard asked for on the first visit to
# https://$UPTIME_KUMA_HOST (status.boltmesh.net) — kuma's login is
# username-based, not email-based. There is no token alternative (kuma's
# management surface is socket.io, which authenticates with the login). Leave
# empty and the reconciler self-skips with a one-line note; the monitors are
# still configurable in the UI.
KUMA_USERNAME=
KUMA_PASSWORD=
