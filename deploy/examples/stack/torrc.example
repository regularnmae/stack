# Template for tor's configuration.
#
# deploy/install.sh seeds $DATA_DIR/tor/torrc only on a fresh host, computing the
# control-password hash from TOR_SERVICE_PASSWORD with
# `podman run --rm localhost/tor:<tag> tor --hash-password`. On an existing
# host the file is left alone. Carries no secret (the hash is derived).
SocksPort 0.0.0.0:9050
ControlPort 0.0.0.0:9051

HashedControlPassword 16:REPLACE_WITH_TOR_HASH_PASSWORD

# Only containers on the podman npm-network may use the SOCKS proxy; reject
# everything else so this can never act as an open proxy.
SocksPolicy accept 10.89.0.0/24
SocksPolicy reject *

# Log to stdout so "podman logs tor" works.
Log notice stdout

# The onion services (boltmesh.net, api.boltmesh.net, mcp.boltmesh.net). This
# block is a *declaration*: deploy/install.sh rewrites it on every run from
# ONION_SERVICES in stack.conf, so change it there, not here. The keys tor
# creates under each HiddenServiceDir are what make the address stable; they are
# mounted from $DATA_DIR/tor/onion and are part of the backup set.
# >>> onion services (rendered by deploy/install.sh from ONION_SERVICES)
HiddenServiceDir /var/lib/tor/onion/boltmesh
HiddenServicePort 80 boltmesh-frontend:80
HiddenServiceDir /var/lib/tor/onion/api
HiddenServicePort 80 boltmesh-backend:8000
HiddenServiceDir /var/lib/tor/onion/mcp
HiddenServicePort 80 host.containers.internal:80
# <<< onion services
