# Template for bitcoind's config file.
#
# bitcoind owns this file itself, under its data directory
# ($DATA_DIR/bitcoin/bitcoin.conf), which is not part of this repo. It is shown
# here for reference because the MCP servers and lightningd read its RPC
# credentials. Carries no real secret.
server=1
daemon=0

# Full (archival) node: keep and validate the whole chain. Do not set prune:
# reverting it requires re-downloading the blockchain.
# txindex resolves any historical txid for btc-explorer; Core builds it in the
# background from the existing block files (no -reindex).
prune=0
txindex=1

# Validation cache, in MiB (Core's default is 450). The one knob that materially
# speeds up the initial block download, because it cuts chainstate writes to
# disk; drop it back to 450 once the chain is synced.
dbcache=3072

# RPC. rpcallowip is the podman subnet only, so a re-added PublishPort would
# still be refused.
rpcuser=btcuser
rpcpassword=change-me
rpcbind=0.0.0.0
rpcallowip=127.0.0.1
rpcallowip=10.89.0.0/24

# NBXplorer (BTCPay) follows blocks over P2P, so this is on; no host port is
# published, so it only accepts the podman subnet.
listen=1
