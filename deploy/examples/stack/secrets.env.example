# Template for the node stack's secrets.
#
# deploy/install.sh writes the real file to $DATA_DIR/config/stack/secrets.env
# (mode 600), seeded from the previously-installed units so adopting it changes
# no credential. It is never committed. This example carries no secret.
BITCOIN_RPC_USER=btcuser
BITCOIN_RPC_PASSWORD=change-me
TOR_SERVICE_PASSWORD=change-me
# The btcpay role in the existing Postgres cluster.
BTCPAY_DB_PASSWORD=change-me
# Appended by install.sh when it is missing, never rewritten: the crowdsec
# container registers this exact key in its LAPI on start, so a new value leaves
# the old bouncer registered and enforcement silently dead (the LAPI answers 403
# and stack-bouncer reports "LAPI unreachable").
CROWDSEC_BOUNCER_KEY=change-me
