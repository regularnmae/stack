# Template for the MCP server's bearer token.
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/victoria-logs-mcp/token.env (mode 600): it reuses the token
# the running container already uses, or generates one, then never touches it
# again. This example is the only token-shaped thing in the repo and
# carries no secret.
#
# Clients must send the same value in the Authorization header:
#   Authorization: Bearer <token>
#
# This token is the whole boundary around the log history: every container's
# stdout is in the store, and a leaked token reads 14 days of it. Rotate it
# with `scripts/rotate.sh token:victoria-logs-mcp` if it leaks.
LOGS_MCP_TOKEN=change-me
