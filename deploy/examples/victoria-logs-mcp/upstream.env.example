# Template for the log store this server reads.
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/victoria-logs-mcp/upstream.env (mode 600). VictoriaLogs has
# no authentication of its own and is reachable only on npm-network and the
# host's loopback, so this file carries no secret. The app defaults to the
# same URL; the file exists so the endpoint has one declared owner.
VICTORIA_LOGS_URL=http://victoria-logs:9428
# Optional call timeout in seconds (the app default is 30).
# VICTORIA_LOGS_TIMEOUT=30
