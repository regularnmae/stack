# Template for the metrics store this server reads.
#
# deploy/install.sh writes the real file to
# $DATA_DIR/config/victoriametrics-mcp/upstream.env (mode 600). VictoriaMetrics
# has no authentication of its own and is reachable only on npm-network and
# the host's loopback, so this file carries no secret. The app defaults to the
# same URL; the file exists so the endpoint has one declared owner.
VICTORIA_METRICS_URL=http://victoriametrics:8428
# Optional call timeout in seconds (the app default is 30).
# VICTORIA_METRICS_TIMEOUT=30
# Freshness threshold for get_metrics_health, in seconds. The default matches
# the monitor's MONITOR_METRICS_MAX_AGE_S (300): the textfile collector writes
# every minute, so five minutes quiet is a fault, not a lull.
# METRICS_HEALTH_MAX_AGE_S=300
