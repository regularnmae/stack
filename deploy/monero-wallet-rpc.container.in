# TEMPLATE -- do not symlink this file. deploy/install.sh renders it into
# ~/.config/containers/systemd/monero-wallet-rpc.container (mode 600),
# substituting the @PLACEHOLDERS@ with values from
# $DATA_DIR/config/stack/secrets.env.
#
# `--rpc-login` MUST be on the Exec line, not merely in a config file: the
# image's entrypoint only binds 0.0.0.0 (with --confirm-external-bind) when it
# sees `--rpc-login` in the arguments, and otherwise forces 127.0.0.1, which
# would make the wallet unreachable from the other containers. So the secret
# lives in the generated unit rather than in a wallet config file.
[Unit]
Description=Monero Wallet RPC
After=monerod.service
Requires=monerod.service

[Container]
ContainerName=monero-wallet-rpc
Image=ghcr.io/sethforprivacy/simple-monero-wallet-rpc:latest
Network=npm-network.network

# The wallet RPC can open wallets and move funds, so it is
# authenticated (--rpc-login below) and publishes nothing: no host
# port at all, not even on loopback. The other containers reach it
# as monero-wallet-rpc:18083 on npm-network.

# Ownership NOTE: unlike monerod's entrypoint, this image's
# entrypoint checks /home/monero (image-owned, uid 1000)
# rather than the bind mount, so it will NOT re-own the dir
# for us. Pre-create it and chown to the mapped uid with:
#   podman unshare chown 1000:1000 @DATA_DIR@/monero-wallet-rpc
# (host uid 525287 == in-container uid 1000 == monero user).
# The :z label is required: this host runs SELinux enforcing.
Volume=@DATA_DIR@/monero-wallet-rpc:/home/monero/wallet:z

# NOTE: Exec= replaces the image CMD; the entrypoint prepends
# --non-interactive and, because --rpc-login is present here,
# binds 0.0.0.0 + --confirm-external-bind and drops privileges
# to the monero user via su-exec.
Exec=--wallet-file=/home/monero/wallet/mainnet \
     --password=@MONERO_WALLET_PASSWORD@ \
     --rpc-bind-port=18083 \
     --daemon-address=monerod:18089 \
     --untrusted-daemon \
     --rpc-login=@MONERO_RPC_LOGIN@

# Image ships /healthcheck.sh: calls get_version over JSON-RPC
# with digest auth (creds/port auto-detected from PID 1).
HealthCmd=/healthcheck.sh
HealthInterval=60s
HealthStartPeriod=2m
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
