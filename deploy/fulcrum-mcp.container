# Quadlet unit for the Fulcrum index MCP server.
[Unit]
Description=Fulcrum Index MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service fulcrum.service
Requires=npm-network-network.service

[Container]
ContainerName=fulcrum-mcp
Image=localhost/fulcrum-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the Electrum endpoint this server
# reads. Both live OUTSIDE this repo in $DATA_DIR/config/fulcrum-mcp/ (mode
# 600), written by install.sh; only the *.example files under deploy/ are
# committed.
EnvironmentFile=@CONFIG_DIR@/fulcrum-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/fulcrum-mcp/upstream.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8110 -- it cannot resolve the container name -- while the app still
# listens on 8000 in its own namespace. The firewall opens nothing for it.
# Host-side checks read the container by name on npm-network, through net_curl.
PublishPort=127.0.0.1:8110:8000

# An authenticated MCP initialize probe, so a wedged server is visible and
# restartable. /health is the liveness path; /ready probes Fulcrum and must
# never gate podman, or a syncing indexer would restart-loop this container.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
