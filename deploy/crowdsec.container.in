# CrowdSec: the behaviour engine that turns nginx-proxy-manager's access logs
# and Suricata's external alerts into decisions. Rootless: it reads files,
# never the wire.
#
# Two sources with different reach: NPM's log is the attributable request
# (inside TLS, where the sensor cannot see it), Suricata's alert feed is the
# wire half (plain HTTP, and ports NPM never sees). Neither gives a client on
# the `.onion` path -- tor forwards to host.containers.internal, so every
# visitor is the host's own address.
#
# Local only: DISABLE_ONLINE_API=true means no console, no CAPI blocklist and
# no telemetry leaving this host.
#
# THIS FILE IS A TEMPLATE (.container.in): install.sh substitutes the two
# @..._BOUNCER_KEY@s from $DATA_DIR/config/stack/secrets.env, so it carries a
# secret and is never a committed .container (docs/ids.md).
#
# Enforcement is `stack-bouncer` (deploy/root/bouncer.sh), a root oneshot on a
# timer that polls this LAPI on the host's loopback and writes an nftables set.
[Unit]
Description=CrowdSec (local detection from nginx-proxy-manager logs)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=crowdsec
Image=docker.io/crowdsecurity/crowdsec:v1.8.2
# Host networking on purpose. The LAPI has to be reachable by stack-bouncer,
# which runs as *root on the host*, and rootless podman keeps the npm-network
# bridge in its own netns: a container address is not routable from the host,
# and a published port would put a `rootlessport` process owned by no unit in
# between. config.yaml.local pins it to 127.0.0.1:8080 and it stays key-gated.
Network=host

# CrowdSec keeps its own config here: the entrypoint seeds /etc/crowdsec from
# /staging on first start and installs the hub items named below. A volume, not
# an anonymous dir, so a restart does not re-download the hub index.
Volume=@DATA_DIR@/ids/crowdsec/etc:/etc/crowdsec:z
# Its sqlite decisions DB and hub datafiles. Regenerable, so outside
# BACKUP_PATHS.
Volume=@DATA_DIR@/ids/crowdsec/data:/var/lib/crowdsec/data:z

# nginx-proxy-manager's access logs -- the attributable half. NPM writes them
# as container root (this same user under rootless podman), so :ro needs no
# relabel.
Volume=@DATA_DIR@/npm/data/logs:/var/log/npm:ro

# Suricata's alert-only feed (the second eve-log output in suricata.yaml), the
# wire half. The PARENT is mounted, not ids/suricata: mounting the subdirectory
# would make podman create it as this user on a host that has not run the root
# pass, handing the rootful sensor a user-owned directory. `:ro` without `:z`
# because the files are root-owned and already labelled by the sensor's own :z
# mount.
Volume=@DATA_DIR@/ids:/ids:ro

# This repo's parser and scenarios, rendered by install.sh into
# $CONFIG_DIR/ids/crowdsec/. Individual file binds, not a directory mount:
# /etc/crowdsec belongs to the entrypoint, which only skips its seeding when
# config.yaml/local_api_credentials.yaml are absent -- true, because nothing
# here touches those two files.
Volume=@CONFIG_DIR@/ids/crowdsec/acquis.d/stack.yaml:/etc/crowdsec/acquis.d/stack.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/acquis.d/suricata.yaml:/etc/crowdsec/acquis.d/suricata.yaml:ro,z
# Merged on top of config.yaml, and not config.yaml itself, so the entrypoint
# still seeds /etc/crowdsec.
Volume=@CONFIG_DIR@/ids/crowdsec/config.yaml.local:/etc/crowdsec/config.yaml.local:ro,z
# Where ban durations are decided (a scenario's `duration:` is ignored in 1.8).
# The entrypoint's `rsync --ignore-existing` leaves the seeded copy alone.
Volume=@CONFIG_DIR@/ids/crowdsec/profiles.yaml:/etc/crowdsec/profiles.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/parsers/s01-parse/stack-npm.yaml:/etc/crowdsec/parsers/s01-parse/stack-npm.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/parsers/s02-enrich/stack-whitelists.yaml:/etc/crowdsec/parsers/s02-enrich/stack-whitelists.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/scenarios/stack-http-probing.yaml:/etc/crowdsec/scenarios/stack-http-probing.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/scenarios/stack-http-authfail.yaml:/etc/crowdsec/scenarios/stack-http-authfail.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/scenarios/stack-http-flood.yaml:/etc/crowdsec/scenarios/stack-http-flood.yaml:ro,z
Volume=@CONFIG_DIR@/ids/crowdsec/scenarios/stack-suricata.yaml:/etc/crowdsec/scenarios/stack-suricata.yaml:ro,z

# Stable, so a re-created container keeps its credentials.
Environment=CUSTOM_HOSTNAME=stack-ids
Environment=DISABLE_ONLINE_API=true
# WAL keeps the sqlite writer from blocking the agent's output routine.
Environment=USE_WAL=true
# Registers the bouncer and its key in this LAPI on start; the name must match
# what stack-bouncer authenticates as.
Environment=BOUNCER_KEY_firewall=@CROWDSEC_BOUNCER_KEY@
# The MCP server's own key: a second, read-only bouncer, deletable without
# touching enforcement. Same never-regenerate rule as the firewall key -- the
# entrypoint only adds a bouncer when the name is absent, so a changed value
# leaves the old key registered and answers the new one with 403.
Environment=BOUNCER_KEY_mcp=@CROWDSEC_MCP_BOUNCER_KEY@
# The generic hub parsers the acquisitions need: non-syslog turns a raw line
# into an event, dateparse-enrich turns evt.StrTime into evt.Time (the
# scenarios' leaky buckets are time-based), and suricata-logs parses
# alerts.json. Its filter matches the acquisition's `type: suricata-evelogs`
# label, which non-syslog copies into evt.Parsed.program -- a rename on either
# side turns enforcement off silently, which verify.sh's explain probe catches.
Environment="PARSERS=crowdsecurity/syslog-logs crowdsecurity/dateparse-enrich crowdsecurity/suricata-logs"

# `cscli lapi status` proves the DB, the API and the credentials together.
HealthCmd=/usr/local/bin/cscli -c /etc/crowdsec/config.yaml lapi status
HealthInterval=60s
HealthTimeout=15s
HealthRetries=3
HealthOnFailure=kill
# First boot installs hub items; a slow mirror must not paint it unhealthy.
HealthStartPeriod=180s

[Service]
# HealthOnFailure=kill stops the container, not the unit: without this a three
# failed LAPI probes are terminal and detection stays dead until a human starts
# it. systemd owns the restart, so monitor.sh's NRestarts delta sees it.
Restart=always
# Same reason as the health start period.
TimeoutStartSec=300

[Install]
# Without this the unit never starts at boot: the generator creates the
# .service but pulls it in through this section. See docs/units.md.
WantedBy=default.target
