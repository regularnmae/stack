# Quadlet unit for the VictoriaLogs MCP server.
#
# The authenticated front door to the log store: `victoria-logs` has no
# authentication of its own and is loopback-only on purpose (every container's
# stdout is in it, including any token a service echoed), so a client reaches
# the history through this server and its bearer token, not through the store's
# HTTP API.
[Unit]
Description=VictoriaLogs MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service victoria-logs.service
Requires=npm-network-network.service victoria-logs.service

[Container]
ContainerName=victoria-logs-mcp
Image=localhost/victoria-logs-mcp:latest
Network=npm-network.network

# The bearer token clients must present, and the store this server reads. Both
# live OUTSIDE this repo in $DATA_DIR/config/victoria-logs-mcp/ (mode 600),
# written by install.sh; only the *.example files under deploy/ are committed.
EnvironmentFile=@CONFIG_DIR@/victoria-logs-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/victoria-logs-mcp/upstream.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8111 -- it cannot resolve the container name -- while the app still
# listens on 8000 in its own namespace. The firewall opens nothing for it.
PublishPort=127.0.0.1:8111:8000

# An authenticated MCP initialize probe, so a wedged server is visible and
# restartable. /health is the liveness path; /ready probes the store and must
# never gate podman, or a store restart would restart-loop this container.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
