# Quadlet unit for the CrowdSec MCP server. install.sh renders it into
# ~/.config/containers/systemd/, where quadlet turns it into
# crowdsec-mcp.service.
#
# The authenticated front door to the engine's *read* state: which decisions
# are enforced, whether one address is blocked, and the engine's health
# counters. It holds a bouncer key and nothing else: a bouncer may pull
# decisions and cannot write, which is why there is no alert tool (alerts need
# a machine credential, which may also create and delete decisions) and no
# ban/unban tool.
[Unit]
Description=CrowdSec MCP Server (streamable HTTP)
After=network-online.target crowdsec.service
# The engine is the only thing this server can answer about. Stopping crowdsec
# stops this with it.
Requires=crowdsec.service

[Container]
ContainerName=crowdsec-mcp
Image=localhost/crowdsec-mcp:latest

# THE ONE HOST-NETWORK MCP SERVER, and the reason is upstream: crowdsec runs
# with Network=host so stack-bouncer can reach the LAPI on the host's loopback,
# and this host's rootless podman keeps npm-network inside its own namespace,
# so a bridge container cannot reach 127.0.0.1:8080 and
# host.containers.internal lands on the host's LAN address, not its loopback.
# Publishing the LAPI needs an address that is not loopback, and publishing
# this server would put a rootlessport forwarder between NPM and it.
#
# The price: this container shares the host's network namespace and can reach
# every loopback-only service (alertmanager, the metrics and log stores, NPM's
# admin API). It is bounded by the app -- three fixed-URL GETs behind a bearer
# token, no generic fetch tool -- but it is a wider blast radius than any other
# MCP server here.
Network=host

# The bearer token clients present and the bouncer key this server reads
# decisions with. Both live outside this repo in $DATA_DIR/config/crowdsec-mcp/
# (mode 600). The key is a *separate* bouncer ("mcp", not stack-bouncer's
# "firewall"), so the LAPI attributes this server's pulls to its own client and
# revoking it never touches enforcement.
EnvironmentFile=@CONFIG_DIR@/crowdsec-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/crowdsec-mcp/lapi.env

# Bind the host's loopback, not 0.0.0.0: on the host network the latter is a
# LAN surface, and the firewall opens nothing for it. NPM (also host network)
# reaches it at 127.0.0.1:8113, exactly as it reaches a
# `PublishPort=127.0.0.1:<port>` unit.
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8113

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# An authenticated MCP initialize probe, so a wedged server is visible and
# restartable. /health is the liveness path; /ready probes the LAPI and must
# never gate podman, or an engine restart would restart-loop this container.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
