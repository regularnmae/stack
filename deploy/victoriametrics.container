# Quadlet unit for VictoriaMetrics, the stack's metrics store: the history
# behind vmui and the /api/v1 query API -- how fast a chain synced, when a
# service went unhealthy, what the disk did at 03:00. vmalert evaluates the
# alert rules against it, so a store that is down stops paging as well as
# graphing; the sweep's `alerting` section checks this endpoint every run and
# fails the external heartbeat when it does not answer (docs/alerting.md).
#
# Single node, one process, Prometheus-compatible: it scrapes node-exporter and
# itself (deploy/monitoring/scrape.yml), and everything else arrives through
# the textfile collector on deploy/metrics.timer.
[Unit]
Description=VictoriaMetrics (metrics store for the stack)
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=victoriametrics
Image=docker.io/victoriametrics/victoria-metrics:v1.155.0
Network=npm-network.network

# Loopback only, and deliberately NOT behind nginx-proxy-manager: vmui has no
# authentication of its own, and every public host in this stack is
# NPM-declared and TLS-terminated. Reach it over an SSH tunnel -- ssh -L
# 8428:127.0.0.1:8428 thishost, then http://127.0.0.1:8428/vmui. Nothing is
# opened in the firewall.
PublishPort=127.0.0.1:8428:8428

# The scrape config, written from deploy/monitoring/scrape.yml on every run
# (structural config, not operator-tuned: the alerting thresholds live in
# monitor.env). The *directory* is mounted, not the file, because a single-file
# bind keeps the inode it opened and a re-rendered scrape.yml would never reach
# the running VM. Its own directory keeps monitor.env's SMTP credentials out of
# this container.
Volume=@CONFIG_DIR@/monitoring/vm:/etc/vm:ro,z

# The series themselves. Regenerable and outside the backup set; the container
# runs as root == the login user under rootless podman, so install.sh only
# creates the directory.
Volume=@DATA_DIR@/monitoring/vm:/victoria-metrics-data:z

# One Exec= line (a Quadlet Exec= is a single command): the data path, the
# listener, @METRICS_RETENTION@ from stack.conf (retention bounded by time, so
# a busy scrape cannot fill the data disk by surprise) and the scrape config.
# configCheckInterval is required for the reload loop to exist at all: VM does
# not watch -promscrape.config unless it is set.
Exec=-storageDataPath=/victoria-metrics-data -httpListenAddr=:8428 -retentionPeriod=@METRICS_RETENTION@ -promscrape.config=/etc/vm/scrape.yml -promscrape.configCheckInterval=30s

# The image ships wget, and /-/healthy is VM's own liveness endpoint.
HealthCmd=wget -q -T 4 -t 1 -O /dev/null http://127.0.0.1:8428/-/healthy
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
