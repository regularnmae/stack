# Quadlet unit for Uptime-Kuma, the public status page. Its state (monitors,
# history, login and an EMBEDDED MARIADB -- kuma v2 dropped sqlite) lives in
# @DATA_DIR@/uptime-kuma and everything else is configured in its web UI, which
# is why this is the one unit with no env file.
[Unit]
Description=Uptime-Kuma (public status page)
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=uptime-kuma
# Exact tag, not `:2`: the dashboard login is internet-facing, and 2.5.11 is
# the first release with the admin RCE fix. The exact pin is what makes a
# deploy take that fix instead of whatever the floating major tag last left on
# the host.
Image=docker.io/louislam/uptime-kuma:2.5.11
Network=npm-network.network

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8107 (the [npm.*] tables of deploy/services.toml) -- it cannot
# resolve the container name. The firewall opens nothing for it, so NPM (which
# terminates TLS) stays the only way in for a client.
PublishPort=127.0.0.1:8107:3001

# The monitors resolve the public vhosts *here*, not on the internet.
# host-gateway is pasta's 169.254.1.2, so a check reaches nginx-proxy-manager
# directly: no trip through the router's NAT loopback, and the certificate
# still validates because the URL (and its SNI) is unchanged.
#
# MCP_HOST is deliberately absent: its monitor is the one canary that still
# leaves the host, and verify.sh reads that source address to notice a WAN
# change. install.sh builds the list from the service manifest, so a host
# rename cannot leave a stale entry here.
PodmanArgs=@KUMA_ADD_HOSTS@

# kuma's embedded MariaDB, its own sqlite-era leftovers and the uploaded
# images. The top level is written by container root (= the host user), so
# install.sh only mkdirs it; mariadb/ and run/ inside are owned by kuma's
# in-image uid (host subuid 525287), which is why the restore runbook chowns
# the datadir it recreates.
#
# The live mariadb/ datadir is NOT in the backup set (BACKUP_EXCLUDES): restic
# would copy a tree MariaDB is writing one file at a time. scripts/db-dump.sh
# takes `mariadb-dump --single-transaction` into
# $DATA_DIR/uptime-kuma-dump/kuma.sql, and the restore runbook imports it.
# `run/` is excluded for the same "not state" reason.
Volume=@DATA_DIR@/uptime-kuma:/app/data:z

# `extra/healthcheck` is the Go binary the image ships for exactly this.
#
# 5 retries, not 3: a version bump migrates the database before it opens :3001,
# and the migration is not bounded by the start period, so 3 failed probes
# would kill the container between the migration and the first answer.
# health-lint: HC005 5 retries -- a schema migration can outlast a 3-probe
# window
HealthCmd=extra/healthcheck
HealthInterval=60s
HealthTimeout=15s
HealthStartPeriod=180s
HealthRetries=5
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
