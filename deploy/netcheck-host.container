# Quadlet unit for the long-lived curl client on the HOST network, the pair to
# netcheck.container. nginx-proxy-manager runs on the host network and binds
# 127.0.0.1:81 itself: a container on npm-network cannot reach a loopback bind
# (pasta delivers host.containers.internal into the host namespace, not onto
# host loopback) and podman rejects host + bridge on one container. So
# net_curl_host execs into this one.
#
# Both sleepers are the same image; only their network differs. Nothing listens
# here and nothing is published.
[Unit]
Description=netcheck-host (long-lived curl client on the host network)
After=network-online.target

[Container]
ContainerName=netcheck-host
Image=localhost/netcheck:local
Network=host
Exec=sleep infinity

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
