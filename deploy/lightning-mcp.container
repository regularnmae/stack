# Quadlet unit for the Core Lightning MCP server.
[Unit]
Description=Core Lightning MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service lightningd.service
Requires=npm-network-network.service

[Container]
ContainerName=lightning-mcp
Image=localhost/lightning-mcp:latest
Network=npm-network.network

# Three env files, all OUTSIDE this repo under $DATA_DIR/config/lightning-mcp/
# (mode 600), so no secret is committed:   token.env -- LIGHTNING_MCP_TOKEN
# (read) and LIGHTNING_MCP_SPEND_TOKEN   node.env  -- the runes (read + spend)
# and the TLS settings   spend.env -- ENABLE_SPENDING and the caps
# (operator-editable)
EnvironmentFile=@CONFIG_DIR@/lightning-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/lightning-mcp/node.env
EnvironmentFile=@CONFIG_DIR@/lightning-mcp/spend.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8104 -- it cannot resolve the container name. This is a money-moving
# surface, so the loopback bind is the only host-visible port there is.
PublishPort=127.0.0.1:8104:8000

# An authenticated MCP initialize probe, which makes a wedged server visible
# and restartable instead of silently erroring.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
