# Quadlet unit for the MCP server itself. deploy/install.sh renders this
# into ~/.config/containers/systemd/, where quadlet turns it into
# lightning-mcp.service.
[Unit]
Description=Core Lightning MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service lightningd.service
Requires=npm-network-network.service

[Container]
ContainerName=lightning-mcp
Image=localhost/lightning-mcp:latest
Network=npm-network.network

# Three env files, all OUTSIDE this repo under $DATA_DIR/config/lightning-mcp/
# (mode 600), written by deploy/install.sh so no secret is committed:
#   token.env -- LIGHTNING_MCP_TOKEN (read) and LIGHTNING_MCP_SPEND_TOKEN
#   node.env  -- the runes (read + spend) and the TLS settings
#   spend.env -- ENABLE_SPENDING and the caps (operator-editable)
EnvironmentFile=@CONFIG_DIR@/lightning-mcp/token.env
EnvironmentFile=@CONFIG_DIR@/lightning-mcp/node.env
EnvironmentFile=@CONFIG_DIR@/lightning-mcp/spend.env

# Host 8104 -> container 8000. Loopback only: NPM is the sole path in (it
# reaches the container as lightning-mcp:8000 on npm-network). This is a
# money-moving surface: NPM's TLS plus the bearer tokens are the gate, and
# nothing on the LAN can reach 8104.
PublishPort=127.0.0.1:8104:8000

HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=restart

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
