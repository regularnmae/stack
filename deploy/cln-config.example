# Template for lightningd's config file.
#
# deploy/install.sh writes the real file to ~/data/cln/config (mode 600),
# reusing the values the previous lightningd unit carried. lightningd reads it
# at its default path ($LIGHTNINGDIR/config) at startup, which is why these
# two secrets are not on the unit's Exec line. Carries no secret.
#
# Any lightningd option may appear here without the leading `--`,
# one per line as key=value.
bitcoin-rpcuser=btcuser
bitcoin-rpcpassword=change-me
tor-service-password=change-me
