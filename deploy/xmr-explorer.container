# Quadlet unit for MoneroBlock, the Monero explorer served at
# $XMR_EXPLORER_HOST. It is read-only and stateless: blocks, transactions and
# network info come from monerod's restricted RPC -- no chain mount, no LMDB
# reader, no local index, no env file, nothing in the backup set.
#
# The container IP is pinned because tor's onion target is this address, and
# tor validates a HiddenServicePort target when it starts -- before this
# container may exist on a fresh host. Keep it unique (tor .240, boltmesh
# .241/.242, btc-explorer .243).
[Unit]
Description=MoneroBlock (trustless Monero block explorer)
After=network-online.target npm-network-network.service monerod.service
Wants=monerod.service
Requires=npm-network-network.service

[Container]
ContainerName=xmr-explorer
Image=localhost/xmr-explorer:local
Network=npm-network.network
IP=10.89.0.244

# Loopback only: nginx-proxy-manager runs on the host network and reaches this
# on host 8109, and it terminates TLS.
PublishPort=127.0.0.1:8109:31312

# The image's ENTRYPOINT is `moneroblock`, so Exec= supplies only its flags.
# --daemon is the restricted RPC port (the unrestricted one is never exposed),
# and MoneroBlock prepends http:// when the URL has no scheme.
Exec=--bind=0.0.0.0:31312 --daemon=monerod:18089

# /style.css is the static stylesheet: a 200 proves the listener without
# touching monerod. The home page calls get_info/get_block_headers_range, and
# monerod's restricted RPC can be slow enough during initial sync that the page
# times out -- verify.sh checks the home page separately and warns rather than
# fails there.
HealthCmd=curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:31312/style.css
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
# MoneroBlock panics on its first RPC poll while monerod is still opening its
# LMDB, and systemd's default RestartSec turned that into a start rate past its
# own default start limit, leaving the explorer failed. Thirty seconds outlives
# the start-limit window and gives monerod time to open the restricted RPC;
# deploy_explorers does not wait on that port, so the retry is the recovery.
RestartSec=30s
TimeoutStartSec=300

[Install]
WantedBy=default.target
