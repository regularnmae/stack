# The schedule for the metrics collector in deploy/metrics.service.
#
# Quadlet has no .timer type, so this is a plain systemd USER unit (like
# backup.timer and monitor.timer); install.sh installs it and enables it
# --user.
#
# Every minute, because that is the resolution the history is read at (a
# chain's sync rate, a disk's saturation), and a jittered minute would only add
# noise.
[Unit]
Description=Collect the stack's metrics every minute

[Timer]
OnCalendar=*:0/1
Persistent=true
Unit=metrics.service

[Install]
WantedBy=timers.target
