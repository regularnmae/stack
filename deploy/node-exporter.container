# Quadlet unit for node_exporter, the stack's window on the host itself: disk,
# inodes, I/O saturation, memory and load, which nothing else watches. It also
# serves the textfile collector ($DATA_DIR/monitoring/textfile/*.prom), which
# is how scripts/metrics.sh and scripts/monitor.sh publish the numbers no
# daemon exports.
[Unit]
Description=node_exporter (host metrics and the stack's textfile metrics)
After=network-online.target

[Container]
ContainerName=node-exporter
Image=docker.io/prom/node-exporter:v1.12.1
Network=host

# On the host network, and NOT a container on npm-network with a PublishPort:
# the netdev and netstat collectors read /proc/net, whose entries are scoped to
# the network namespace at read time, so through this container's own /proc the
# host's NIC is invisible and the store has no history of its bandwidth.
#
# The listener binds the wildcard, and 127.0.0.1 will NOT do: rootless podman
# keeps the npm-network bridge and its 10.89.0.1 gateway inside the userns, so
# no gateway address exists in the host namespace to bind, and pasta delivers a
# container's host.containers.internal dial into the host namespace but not
# onto host loopback. The LAN exposure that wildcard implies is closed by the
# firewall: 9100 is not in FIREWALL_PORTS. victoriametrics scrapes it as
# host.containers.internal:9100.

# Read-only host mounts. /proc and /sys carry the kernel counters;
# --path.rootfs makes the filesystem collectors stat the real mountpoints.
#
# Mounting / looks alarming, but it is read-only and the container runs as uid
# 65534, which under rootless podman is a *subuid*: it cannot read the stack's
# 0600 secrets or the chain data no matter that the path is visible.
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
Volume=/:/host:ro

# SELinux is enforcing here and the host mounts above carry the host's own
# labels, which a container domain may not read, and relabelling / is not an
# option. That is why this unit has SELinux separation off, its mounts are all
# :ro, and its listener is closed to the LAN by the firewall. The textfile dir
# keeps its :z label so it still works if the label is ever re-enabled.
SecurityLabelDisable=true

# Where metrics.sh (every minute) and monitor.sh (every five) write their .prom
# files. Must be world-readable: the exporter runs as uid 65534, which owns
# nothing here, and a silent "no metrics" is otherwise the first failure mode.
Volume=@DATA_DIR@/monitoring/textfile:/textfile:z

Exec=--web.listen-address=:9100 --path.procfs=/host/proc --path.sysfs=/host/sys --path.rootfs=/host --collector.textfile.directory=/textfile

# The image ships busybox wget and runs as nobody: scraping its own /metrics
# proves the listener.
HealthCmd=wget -q -T 4 -t 1 -O /dev/null http://0.0.0.0:9100/metrics
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=15s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
