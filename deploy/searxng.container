# The SearXNG instance search_web queries. Owned by this repo so the MCP
# server can be deployed whole. Its settings live in @DATA_DIR@/searxng;
# deploy/install.sh seeds them (json format + valkey) only on a fresh
# host -- see deploy/searxng/settings.yml.
[Unit]
Description=SearXNG Metasearch Engine
After=network-online.target npm-network-network.service valkey.service
Requires=npm-network-network.service valkey.service

[Container]
ContainerName=searxng
Image=docker.io/searxng/searxng:latest
Network=npm-network.network

# Loopback only: NPM is the sole path in. It proxies it as searxng:8080
# on npm-network without touching this file, and the loopback bind keeps
# verify.sh and local debugging working. Nothing on the LAN can reach 8080.
PublishPort=127.0.0.1:8080:8080

# Image entrypoint generates a default settings.yml with a
# random secret_key on first start if the mount is empty.
# :z label required (SELinux enforcing host), same as monerod.
Volume=@DATA_DIR@/searxng:/etc/searxng:z

# The rate limiter is ON (settings.yml) -- it needs valkey, which is why
# Requires=valkey.service above. Image defaults would leave it off.

# The image ships no HEALTHCHECK; SearXNG exposes /healthz for exactly this.
# wget is present in the image (curl is not).
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/healthz
HealthInterval=30s
HealthStartPeriod=30s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
