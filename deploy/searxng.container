# The SearXNG instance search_web queries. Its settings live in
# @DATA_DIR@/searxng; install.sh seeds them (json format + valkey) only on a
# fresh host -- see deploy/searxng/settings.yml.
[Unit]
Description=SearXNG Metasearch Engine
After=network-online.target npm-network-network.service valkey.service
Requires=npm-network-network.service valkey.service

[Container]
ContainerName=searxng
Image=docker.io/searxng/searxng:2026.10.29-cff884f98
Network=npm-network.network

# Loopback only: nginx-proxy-manager runs on the host network, so host 8082 is
# how it reaches SearXNG. 8082 rather than 8080 because crowdsec's LAPI owns
# host 8080 -- that unit runs on the host network, so its socket is the host's
# own and stack-bouncer reads it without a published port. The MCP server
# reaches SearXNG as searxng:8080 on npm-network.
PublishPort=127.0.0.1:8082:8080

# The image entrypoint generates a default settings.yml with a random
# secret_key on first start if the mount is empty.
Volume=@DATA_DIR@/searxng:/etc/searxng:z

# The rate limiter is ON (settings.yml), which is what needs valkey; the image
# defaults would leave it off.

# The image ships no HEALTHCHECK; SearXNG exposes /healthz for exactly this.
# wget is present (curl is not).
HealthCmd=wget -q -T 4 -t 1 -O /dev/null http://127.0.0.1:8080/healthz
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
