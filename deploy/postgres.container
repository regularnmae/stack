# Quadlet unit for the BoltMesh database.
#
# The cluster is the one piece of BoltMesh state that cannot be recreated: the
# nightly backup takes a pg_dumpall (deploy/postgres-dump.container), never a
# raw copy of a live PGDATA.
[Unit]
Description=BoltMesh PostgreSQL
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=postgres
Image=docker.io/library/postgres:18-alpine
Network=npm-network.network

# Only the backend/worker reach it, as postgres:5432 on npm-network, so it
# publishes nothing. The image's PGDATA is /var/lib/postgresql/18/docker, a
# subdirectory of the mount point. `:z` because the host runs SELinux
# enforcing.
Volume=@DATA_DIR@/postgres:/var/lib/postgresql:z

# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD, plus the DATABASE_URL the
# backend reads (same password); the server ignores DATABASE_URL.
EnvironmentFile=@CONFIG_DIR@/boltmesh/db.env

# Graceful stop, not podman's 10 s default: a fast shutdown runs a final
# checkpoint, and a SIGKILL mid-checkpoint is WAL replay on the next start.
# TimeoutStopSec below stays 30 s above it (docs/units.md, "A durable unit is
# stopped, not killed").
StopTimeout=60

# The image ships no HEALTHCHECK. Probe over TCP rather than the Unix socket so
# the check is meaningful and needs no shell or environment expansion -- a $VAR
# here would be expanded by the systemd generator, not the container.
#
# 5 retries, not 3: after a crash, postgres answers only once WAL replay
# finishes, and 3 probes (90 s) can kill it mid-recovery -- the one state where
# a restart makes the next start slower.
# health-lint: HC005 5 retries -- crash recovery (WAL replay) outlasts 3 probes
HealthCmd=pg_isready -h 127.0.0.1 -U vpnuser -d vpndb
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=5
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=90s

[Install]
WantedBy=default.target
