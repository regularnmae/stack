# Quadlet unit for the Monero full (archival) node. No secrets: the restricted
# RPC runs without a login, and standard RPC (18081) stays on loopback
# in-container.
[Unit]
Description=Monero Node
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=monerod
Image=ghcr.io/sethforprivacy/simple-monerod:v0.18.5.4
Network=npm-network.network

# Same policy as bitcoind: no ports published. P2P is outbound-only, which is
# enough to sync, and the restricted RPC stays inside npm-network even though
# it binds 0.0.0.0 in-container.
#PublishPort=18080:18080
#PublishPort=18089:18089

# The entrypoint runs as root only long enough to re-own this directory for its
# monero user (host uid 525287 via /etc/subuid), then drops privileges via
# su-exec, so it can be created as $USER -- unlike bitcoind, no chown dance.
Volume=@DATA_DIR@/monero:/home/monero/.bitmonero:z
# The BTCPay plugin's block callback, run on every new block: it refreshes the
# plugin wallet and pokes BTCPay's Monero callback so a paid invoice is
# rescanned without waiting for the next poll. install.sh stages it under the
# data dir on every run -- monerod only fails at its *next start*, on a missing
# bind source. Edit the repo copy (deploy/btcpay/monero-notify.sh) and deploy.
Volume=@DATA_DIR@/bin/monero-notify.sh:/notify-block.sh:ro,z

# Graceful stop, not podman's 10 s default. monerod's SIGTERM path closes LMDB
# (`Deinitializing core...`), which on a large DB over a rotational disk does
# not finish in 10 s. TimeoutStopSec below stays 30 s above it, or systemd
# kills the cgroup first (docs/units.md, "A durable unit is stopped, not
# killed", has the measurements).
StopTimeout=300

# NOTE: Exec= replaces the image CMD, so the image's default flags must be
# restated verbatim, with our additions appended (the entrypoint prepends
# --non-interactive itself). --block-sync-size above the compiled default of 20
# amortises one download span, verify pass and LMDB transaction over more
# blocks; it is not free to raise, because a batch larger than the span
# scheduler completes between announcements stalls the sync with nothing
# logged.
Exec=--rpc-restricted-bind-ip=0.0.0.0 \
     --rpc-restricted-bind-port=18089 \
     --no-igd --no-zmq --enable-dns-blocklist \
     --ban-list=/home/monero/ban_list.txt \
     --block-sync-size=50 \
     --block-notify=/notify-block.sh

# Liveness is the process itself: the entrypoint execs monerod as PID 1, so
# this is the whole check, exactly like Fulcrum's
# (deploy/fulcrum.container.in). Deliberately NOT the image's /healthcheck.sh,
# which curls the restricted RPC: that asserts the *data* path, and the handler
# legitimately blocks while the chain lock is held across a --block-sync-size
# batch, so the check kills a node mid-sync. A socket check is no better --
# after such a kill the daemon re-opens LMDB before it binds and refuses
# connections until then. The functional checks live outside the unit:
# metrics.sh's stack_xmr_rpc_up, monitor.sh's RPC verdict and verify.sh --deep
# (docs/units.md, "Healthchecks follow a contract").
HealthCmd=sh -c 'grep -qx monerod /proc/1/comm'
HealthInterval=60s
HealthTimeout=15s
HealthStartPeriod=2m
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=330s

[Install]
WantedBy=default.target
