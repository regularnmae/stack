# Quadlet unit for the SearXNG MCP server.
[Unit]
Description=SearXNG MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service searxng.service
Requires=npm-network-network.service searxng.service

[Container]
ContainerName=searxng-mcp
Image=localhost/searxng-mcp:latest
Network=npm-network.network

# Bearer token clients present as `Authorization: Bearer <token>`. The token
# lives OUTSIDE this repo in $DATA_DIR/config/searxng-mcp/token.env (mode 600),
# written by install.sh; only deploy/examples/searxng-mcp/token.env.example is
# committed. The same value sits in the Authorization header of
# ~/.config/opencode/opencode.json.
EnvironmentFile=@CONFIG_DIR@/searxng-mcp/token.env

# SDK chatter (transport/session lifecycle) is per-client noise; keep only
# WARNING and up so the log stays error- and warning-shaped.
Environment=LOG_LEVEL=WARNING

# Loopback only: nginx-proxy-manager runs on the host network, so host 8100 is
# how it reaches this server -- NPM cannot resolve the container name. The
# firewall opens nothing for it, and host-side checks keep reading the
# container by name on npm-network through net_curl.
PublishPort=127.0.0.1:8100:8000

# An authenticated MCP initialize probe, which makes a wedged server visible
# and restartable instead of silently erroring.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
