# Quadlet unit for the MCP server itself. deploy/install.sh renders this
# into ~/.config/containers/systemd/, where quadlet turns it into
# searxng-mcp.service.
[Unit]
Description=SearXNG MCP Server (streamable HTTP)
After=network-online.target npm-network-network.service searxng.service
Requires=npm-network-network.service searxng.service

[Container]
ContainerName=searxng-mcp
Image=localhost/searxng-mcp:latest
Network=npm-network.network

# Bearer token clients must present as `Authorization: Bearer <token>`.
# The token lives OUTSIDE this repo in $DATA_DIR/config/searxng-mcp/token.env
# (mode 600), written by deploy/install.sh, so no secret is ever
# committed -- only deploy/token.env.example is. The same value sits in
# the Authorization header of ~/.config/opencode/opencode.json.
EnvironmentFile=@CONFIG_DIR@/searxng-mcp/token.env

# Loopback only: nginx-proxy-manager runs on the host network, so host 8100 is
# how it reaches this server (NPM_HOSTS/MCP_HOSTS in stack.conf) -- NPM can no
# longer resolve the container name. Bind 127.0.0.1, never a LAN address: the
# firewall opens nothing for it and NPM is still the only way in for a client.
# The host-side checks keep reading the container by name on npm-network
# through scripts/lib.sh's net_curl.
PublishPort=127.0.0.1:8100:8000

# Healthcheck: MCP initialize probe (authenticated). Makes a
# wedged server visible/restartable instead of silently erroring.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=restart

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
