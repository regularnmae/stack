# TEMPLATE -- do not symlink this file. install.sh renders it into
# ~/.config/containers/systemd/lightningd.container (mode 600), substituting
# the @PLACEHOLDERS@ from $DATA_DIR/config/stack/secrets.env.
#
# Exec= cannot expand environment variables (Quadlet does not do that) and
# lightningd needs its secrets as arguments, so the secret is rendered in place
# rather than kept on a committed unit. The rendered file is the only copy.
[Unit]
Description=Core Lightning Daemon
After=bitcoind.service tor.service
Requires=bitcoind.service tor.service

[Container]
ContainerName=lightningd
Image=docker.io/elementsproject/lightningd:v26.06.9
Network=npm-network.network

# Lightning P2P is deliberately NOT published: 9735 on 0.0.0.0 would advertise
# this host's real IP to every peer and defeat Tor, which is why peers use the
# statictor onion service. clnrest binds 3010 in-container for lightning-mcp
# and is not published.

# Volume mount using @DATA_DIR@/cln. `:z` (shared), not `:Z` (private): the
# backup container mounts the same directory read-only, and two containers may
# not share a path one labels private -- whichever starts last would relabel it
# and lock the other out.
Volume=@DATA_DIR@/cln:/root/.lightning:z

# Map host bitcoind directory into CLN
Volume=@DATA_DIR@/bitcoin:/root/.bitcoin:z

# Graceful stop, not podman's 10 s default: CLN commits its database and gives
# the plugins a bounded time to exit on SIGTERM. The budget has to outlast a
# bitcoind that is down or still loading: bcli's RPC call blocks CLN's shutdown,
# and 60 s was not enough (podman SIGKILLs the container when the budget runs
# out mid-stop).
# TimeoutStopSec below stays 30 s above this (docs/units.md, "A durable unit is
# stopped, not killed").
StopTimeout=120

# Exec arguments connecting to bitcoind and tor. NOTE: --proxy expects an IP
# address (it does not accept a hostname) and --always-use-proxy=true
# suppresses DNS lookups, so Tor must be addressed by its pinned IP 10.89.0.240
# (set in tor.container) rather than "tor".
Exec=--network=bitcoin \
     --bitcoin-rpcconnect=bitcoind \
     --bitcoin-rpcport=8332 \
     --bitcoin-rpcuser=@BITCOIN_RPC_USER@ \
     --bitcoin-rpcpassword=@BITCOIN_RPC_PASSWORD@ \
     --bitcoin-datadir=/root/.bitcoin \
     --clnrest-port=3010 \
     --clnrest-host=0.0.0.0 \
     --proxy=10.89.0.240:9050 \
     --addr=statictor:10.89.0.240:9051 \
     --tor-service-password=@TOR_SERVICE_PASSWORD@ \
     --always-use-proxy=true \
     --bind-addr=0.0.0.0:9735

# The image's entrypoint.sh stays alive as PID 1 after lightningd dies (bcli
# timing out while bitcoind opened its wallet), so the unit read "active" with
# the daemon and clnrest gone. The healthcheck makes that visible and
# HealthOnFailure=kill makes it terminal, so Restart=always below recreates it
# -- podman's man page says the same: inside a unit prefer kill/stop and let
# systemd's restart policy act.
#
# Deliberately NOT on the BTCPay wallet: its healthcheck is red by design while
# the wallet refreshes, and killing it would restart that refresh.
HealthCmd=lightning-cli getinfo
HealthInterval=60s
HealthTimeout=15s
HealthStartPeriod=5m
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=150s

[Install]
WantedBy=default.target
