# TEMPLATE -- do not symlink this file. deploy/install.sh renders it into
# ~/.config/containers/systemd/lightningd.container (mode 600), substituting
# the @PLACEHOLDERS@ with values from $DATA_DIR/config/stack/secrets.env.
#
# Exec= cannot expand environment variables (Quadlet does not do that), and
# lightningd needs its secrets as arguments, so the unit is generated with the
# secret in place rather than keeping it on a committed static unit. The
# rendered file is the only copy and never enters git.
[Unit]
Description=Core Lightning Daemon
After=bitcoind.service tor.service
Requires=bitcoind.service tor.service

[Container]
ContainerName=lightningd
Image=docker.io/elementsproject/lightningd:latest
Network=npm-network.network

# Lightning P2P & CLNRest API ports
# 9735 is deliberately NOT published: it would bind on 0.0.0.0 on the host,
# advertise this host's real IP to every peer and defeat the point of Tor.
# Peers reach us through the statictor onion service instead.
#PublishPort=3010:3010

# Volume mount using @DATA_DIR@/cln. `:z` (shared), not `:Z` (private): the
# backup container mounts the same directory read-only, and two containers may
# not share a path one labels private -- whichever starts last would relabel it
# and lock the other out. bitcoind and monero-wallet-rpc already use `:z`.
Volume=@DATA_DIR@/cln:/root/.lightning:z

# Map host bitcoind directory into CLN
Volume=@DATA_DIR@/bitcoin:/root/.bitcoin:z

# Exec arguments connecting to bitcoind and tor.
# NOTE: --proxy expects an IP address (it does not accept a hostname) and
# --always-use-proxy=true suppresses DNS lookups, so Tor must be addressed by
# its pinned IP 10.89.0.240 (set in tor.container) rather than "tor".
Exec=--network=bitcoin \
     --bitcoin-rpcconnect=bitcoind \
     --bitcoin-rpcport=8332 \
     --bitcoin-rpcuser=@BITCOIN_RPC_USER@ \
     --bitcoin-rpcpassword=@BITCOIN_RPC_PASSWORD@ \
     --bitcoin-datadir=/root/.bitcoin \
     --clnrest-port=3010 \
     --clnrest-host=0.0.0.0 \
     --proxy=10.89.0.240:9050 \
     --addr=statictor:10.89.0.240:9051 \
     --tor-service-password=@TOR_SERVICE_PASSWORD@ \
     --always-use-proxy=true \
     --bind-addr=0.0.0.0:9735

# The image's entrypoint.sh stays alive as PID 1 even after lightningd dies,
# so systemd reported the unit "active" while the daemon was gone. This
# healthcheck makes that failure visible.
HealthCmd=lightning-cli getinfo
HealthInterval=60s
HealthStartPeriod=5m
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
