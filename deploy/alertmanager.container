# Quadlet unit for Alertmanager, the stack's alert state machine.
#
# It owns what monitor.sh deliberately does not: grouping, repeat intervals,
# inhibition, silences, routing, and a delivery path that reports its own
# failures. monitor.sh still decides WHAT is wrong; Alertmanager decides WHEN
# to say it and over which channel.
#
# Push-only, nothing is scraped: monitor.sh POSTs the current alert set to
# /api/v2/alerts every five minutes and resolves an alert EXPLICITLY (an endsAt
# in the past) when its check goes away. That is why the config's
# resolve_timeout is 24h -- anything near the push interval would declare a
# healthy alert resolved between two sweeps and mail "recovered" for something
# that never recovered. 24h only bounds the damage if monitor.sh stops pushing
# altogether.
#
# Nothing here reads the metrics store, so a wedged or deleted VictoriaMetrics
# cannot silence an alert.
#
# Not behind nginx-proxy-manager: the UI and the API have no authentication of
# their own, so this is loopback only, like vmui, and absent from NPM_HOSTS and
# FIREWALL_PORTS. Reach it over an SSH tunnel:   ssh -L 9093:127.0.0.1:9093
# thishost    # then http://127.0.0.1:9093
[Unit]
Description=Alertmanager (alert grouping, dedupe and delivery for the stack)
After=network-online.target npm-network-network.service
Requires=npm-network-network.service

[Container]
ContainerName=alertmanager
Image=docker.io/prom/alertmanager:v0.34.2
Network=npm-network.network

# Loopback only: the API accepts alert pushes from a host script and has no
# authentication. Same rule as victoriametrics.
PublishPort=127.0.0.1:9093:9093

# The image's default user is uid 65534 (nobody), which cannot read the 0600
# config that carries the SMTP password, and making that file world-readable
# would leak the credential. Under rootless podman container root IS the login
# user, so running as 0 here is the privilege the rest of the stack already
# runs at.
User=0

# The config: seeded once by install.sh from
# deploy/examples/monitoring/alertmanager.yml.example and the operator's from
# then on, because it holds the SMTP credential.
#
# The DIRECTORY is mounted, not the file, so an atomic replace (an editor's
# write-temp-then-rename) does not leave the container reading a deleted inode.
# That is not a reload: v0.34 has no config watcher, so an edit takes effect
# only after `curl -X POST http://127.0.0.1:9093/-/reload` (or SIGHUP).
Volume=@CONFIG_DIR@/monitoring/alertmanager:/etc/alertmanager:ro,z

# Silences and the notification log. Regenerable (losing a silence un-mutes an
# alert for one repeat interval; losing the log only affects dedupe across a
# restart), so it is outside BACKUP_PATHS.
Volume=@DATA_DIR@/monitoring/alertmanager:/alertmanager:z

# One Exec= line (a Quadlet Exec= is a single command). An empty
# --cluster.listen-address= keeps :9094 closed instead of opening a peer port
# nothing will ever use; --web.external-url is what a notification's links
# point at, which work through the tunnel above and nowhere else.
Exec=--config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager --web.listen-address=:9093 --web.external-url=http://127.0.0.1:9093 --cluster.listen-address=

# The image ships busybox wget, and /-/healthy is Alertmanager's own liveness
# endpoint; 30s because this is an HTTP service.
HealthCmd=wget -q -T 4 -t 1 -O /dev/null http://127.0.0.1:9093/-/healthy
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=15s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
