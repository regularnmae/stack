# Suricata, the stack's network IDS -- the one rootful unit in this repo.
#
# It exists because AF_PACKET capture on enp8s0 needs CAP_NET_RAW in the *init*
# user namespace, and the capability comes from the owning namespace: a
# rootless container is refused the socket ("failed to create socket: Operation
# not permitted"). Rendered into /etc/containers/systemd/ and started by `sudo
# ./bootstrap.sh`; everything else stays rootless.
#
# It never drops packets: enforcement is the crowdsec unit's bouncer, which
# applies the LAPI's decisions to `inet stack_bans` with per-entry timeouts.
# Its external alerts are a *decision source*, so a crash or a bad rules reload
# cannot itself be an outage.
#
# What it can and cannot see is documented in
# deploy/root/suricata/suricata.yaml.
[Unit]
Description=Suricata IDS (stack sensor on enp8s0 + lo)
# A sensor that starts before the LAN is up captures nothing until something
# restarts it.
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=suricata
Image=docker.io/jasonish/suricata:8.0.8
# Host network on purpose: it has to see the namespace nginx-proxy-manager
# binds 80/443 in, including the loopback publishes it proxies to. A podman
# network would give it a private eth0 that sees nothing but its own traffic.
Network=host
# NET_RAW to open the capture socket, NET_ADMIN for the af-packet ring options,
# SYS_NICE so the worker threads can raise their scheduling priority.
# Everything else stays podman's default; this container runs no untrusted
# code.
AddCapability=NET_RAW
AddCapability=NET_ADMIN
AddCapability=SYS_NICE

# EVE JSON (the alert-only feed CrowdSec tails), the engine log and
# suricata-update's log. Root-owned because the container writes as root;
# scripts/ids.sh only reads them. Our `filename`s are static, so Suricata does
# not rotate them itself -- the host's logrotate rule does, and SIGHUPs the
# sensor to reopen. Regenerable telemetry, so outside BACKUP_PATHS.
Volume=@DATA_DIR@/ids/suricata:/var/log/suricata:z
# The ruleset and its cache. On the data disk, not an anonymous volume, so a
# restart does not re-download it and a host without internet still starts.
Volume=@DATA_DIR@/ids/suricata/lib:/var/lib/suricata:z
# The config is rooted in /etc/stack-ids, rendered by install.sh --root.
# Deliberately NOT $DATA_DIR: a user-writable config consumed by a rootful
# container is a privilege boundary.
Volume=/etc/stack-ids/suricata:/etc/suricata-stack:ro,z

# The image's own entrypoint takes a bare "-i <iface>"; this one copies
# local.rules into place, refreshes ET Open best-effort and execs the engine.
Entrypoint=/bin/sh
Exec=/etc/suricata-stack/start.sh

# Proof the engine loaded rules and is turning over. The socket is a POSITIONAL
# argument to suricatasc (the 8.x Rust rewrite takes no -s/--socket flag) and
# its built-in default is /var/run/suricata/suricata-command.socket, a
# subdirectory this config does not use -- spelled out, or the check reports
# "Unable to connect" while the engine runs perfectly.
HealthCmd=/usr/bin/suricatasc -c uptime /run/suricata-command.socket
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
# Rules load before the engine answers.
HealthStartPeriod=180s
# A red check after that means the engine is no longer answering, and a
# container that reads "Up" while the engine is wedged is the failure mode this
# repo documents for lightningd: kill it and let systemd's Restart=always
# recreate it.
HealthOnFailure=kill

[Service]
# A cold start includes the rule update, bounded at 180 s in start.sh;
# systemd's default 90 s would mark the unit failed mid-download.
TimeoutStartSec=300
# Quadlet does not default a restart policy: without this line systemd's own
# default (no) applies, so a clean entrypoint exit or the health kill above
# leaves the sensor down for good.
Restart=always

[Install]
WantedBy=multi-user.target
