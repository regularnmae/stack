# Tor image: a prebuilt alpine with tor installed. The previous approach
# (alpine:latest + "apk add tor" at every boot) required working internet on
# every start; baking the package in removes that dependency.
#
# Both the base and the package are pinned -- tag *and* digest for the base,
# an exact apk version for tor -- so Renovate can bump them (and so a rebuild
# ships the same bits). The local tag is deliberately versionless
# (localhost/tor:local): the versions live only here, not duplicated across
# stack.conf, the quadlet and the README.
#
# 3.20 reached EOL 2026-04-01; this rides 3.24, supported to 2028-06.
#
# Build:  podman build -t localhost/tor:local tor/
FROM docker.io/library/alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache tor=0.4.9.14-r0
