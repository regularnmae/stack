{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "groupName": "container base images"
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "python dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "the shellcheck release CI pins and downloads (SHELLCHECK_VERSION in .github/workflows/ci.yml)",
      "fileMatch": ["^\\.github/workflows/ci\\.yml$"],
      "matchStrings": ["SHELLCHECK_VERSION: (?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "the Uptime-Kuma image tag in its Quadlet unit (Renovate's managers cover Dockerfile FROM and compose files, not Image= lines; pinned to the v2 major, so only patches/minors within it are bumped)",
      "fileMatch": ["^deploy/uptime-kuma\\.container$"],
      "matchStrings": ["Image=docker\\.io/louislam/uptime-kuma:(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "louislam/uptime-kuma"
    },
    {
      "customType": "regex",
      "description": "the Fulcrum image tag in its rendered Quadlet unit (same Quadlet gap as uptime-kuma)",
      "fileMatch": ["^deploy/fulcrum\\.container\\.in$"],
      "matchStrings": ["Image=docker\\.io/cculianu/fulcrum:(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "cculianu/fulcrum"
    },
    {
      "customType": "regex",
      "description": "the btc-rpc-explorer master commit pinned in btc-explorer/Containerfile (the published npm 3.4.0 is stale and does not build on Node 22)",
      "fileMatch": ["^btc-explorer/Containerfile$"],
      "matchStrings": ["ARG BTC_RPC_EXPLORER_COMMIT=(?<currentDigest>[0-9a-f]{40})"],
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "btc-rpc-explorer",
      "packageNameTemplate": "https://github.com/janoside/btc-rpc-explorer"
    },
    {
      "customType": "regex",
      "description": "the MoneroBlock release commit pinned in xmr-explorer/Containerfile (the project's last tag is v0.1.2; current main is the same commit)",
      "fileMatch": ["^xmr-explorer/Containerfile$"],
      "matchStrings": ["ARG MONEROBLOCK_COMMIT=(?<currentDigest>[0-9a-f]{40})"],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "MoneroBlock",
      "packageNameTemplate": "https://github.com/duggavo/MoneroBlock"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
